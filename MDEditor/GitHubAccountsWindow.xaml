<Window x:Class="MDEditor.GitHubAccountsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:MDEditor.Localization"
        Title="{loc:Tr GH_AccountsTitle}" Height="600" Width="520" MinHeight="480" MinWidth="440"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource WindowForegroundBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16">
            <TextBlock Text="{loc:Tr GH_ConnectedAccounts}" FontWeight="SemiBold" Margin="0,0,0,8" />
            <Grid Height="130" Margin="0,0,0,8">
                <ListBox x:Name="AccountsList"
                         Background="{DynamicResource ControlBackgroundBrush}"
                         Foreground="{DynamicResource ControlForegroundBrush}"
                         SelectionChanged="AccountsList_SelectionChanged"
                         MouseDoubleClick="AccountsList_MouseDoubleClick" />
                <TextBlock x:Name="NoAccountsText" Text="{loc:Tr GH_NoAccounts}" Opacity="0.7"
                           HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
            </Grid>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                <Button x:Name="SetActiveButton" Content="{loc:Tr GH_SetActive}" Padding="12,3" Margin="0,0,8,0" Click="SetActive_Click" />
                <Button x:Name="RemoveButton" Content="{loc:Tr Common_Remove}" Padding="12,3" Click="Remove_Click" />
            </StackPanel>

            <TextBlock Text="{loc:Tr GH_SignInBrowserHeading}" FontWeight="SemiBold" Margin="0,0,0,4" />
            <TextBlock TextWrapping="Wrap" Opacity="0.8" Margin="0,0,0,8"
                       Text="{loc:Tr GH_SignInBrowserNote}" />
            <Button x:Name="DeviceFlowButton" Content="{loc:Tr GH_SignInBrowserButton}" Padding="12,3" HorizontalAlignment="Left"
                    Margin="0,0,0,8" Click="DeviceFlow_Click" />

            <Border x:Name="DeviceFlowPanel" Visibility="Collapsed" BorderThickness="1" Padding="12" Margin="0,0,0,8"
                    BorderBrush="{DynamicResource AppBorderBrush}" Background="{DynamicResource ControlBackgroundBrush}">
                <StackPanel>
                    <TextBlock Text="{loc:Tr GH_EnterCode}" Margin="0,0,0,4" />
                    <TextBox x:Name="UserCodeText" IsReadOnly="True" FontFamily="Cascadia Code, Consolas, monospace"
                             FontSize="22" FontWeight="Bold" BorderThickness="0" Background="Transparent"
                             Foreground="{DynamicResource ControlForegroundBrush}" Margin="0,0,0,8" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="{loc:Tr GH_CopyAndOpen}" Padding="12,3" Margin="0,0,8,0" Click="CopyAndOpen_Click" />
                        <Button Content="{loc:Tr Common_Cancel}" Padding="12,3" Click="CancelDeviceFlow_Click" />
                    </StackPanel>
                    <TextBlock x:Name="DeviceFlowStatusText" Text="{loc:Tr GH_Waiting}" Opacity="0.8" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <TextBlock Text="{loc:Tr GH_PatHeading}" FontWeight="SemiBold" Margin="0,12,0,4" />
            <TextBlock TextWrapping="Wrap" Opacity="0.8" Margin="0,0,0,8">
                <Run Text="{loc:Tr GH_PatNote}" />
                <Hyperlink x:Name="CreateTokenLink" Click="CreateTokenLink_Click"><Run Text="{loc:Tr GH_CreateToken}" /></Hyperlink>
            </TextBlock>
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <PasswordBox x:Name="TokenBox" VerticalContentAlignment="Center" Margin="0,0,8,0" KeyDown="TokenBox_KeyDown"
                             Background="{DynamicResource ControlBackgroundBrush}" Foreground="{DynamicResource ControlForegroundBrush}" />
                <Button x:Name="AddTokenButton" Grid.Column="1" Content="{loc:Tr GH_AddToken}" Padding="12,3" Click="AddToken_Click" />
            </Grid>

            <TextBlock x:Name="StatusText" TextWrapping="Wrap" Margin="0,4,0,12" Visibility="Collapsed" />

            <Expander Header="{loc:Tr GH_Advanced}" Margin="0,8,0,0">
                <StackPanel Margin="0,8,0,0">
                    <TextBlock Text="{loc:Tr GH_ClientIdLabel}" TextWrapping="Wrap" Margin="0,0,0,4" />
                    <TextBox x:Name="ClientIdBox" LostFocus="ClientIdBox_LostFocus"
                             Background="{DynamicResource ControlBackgroundBrush}" Foreground="{DynamicResource ControlForegroundBrush}" />
                    <TextBlock TextWrapping="Wrap" Opacity="0.7" Margin="0,4,0,0"
                               Text="{loc:Tr GH_ClientIdNote}" />
                </StackPanel>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</Window>
