<Window x:Class="MDEditor.GitHubAccountsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GitHub Accounts" Height="600" Width="520" MinHeight="480" MinWidth="440"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource WindowForegroundBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16">
            <TextBlock Text="Connected Accounts" FontWeight="SemiBold" Margin="0,0,0,8" />
            <Grid Height="130" Margin="0,0,0,8">
                <ListBox x:Name="AccountsList"
                         Background="{DynamicResource ControlBackgroundBrush}"
                         Foreground="{DynamicResource ControlForegroundBrush}"
                         SelectionChanged="AccountsList_SelectionChanged"
                         MouseDoubleClick="AccountsList_MouseDoubleClick" />
                <TextBlock x:Name="NoAccountsText" Text="No accounts connected yet." Opacity="0.7"
                           HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
            </Grid>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                <Button x:Name="SetActiveButton" Content="Set Active" Padding="12,3" Margin="0,0,8,0" Click="SetActive_Click" />
                <Button x:Name="RemoveButton" Content="Remove" Padding="12,3" Click="Remove_Click" />
            </StackPanel>

            <TextBlock Text="Sign in with Browser" FontWeight="SemiBold" Margin="0,0,0,4" />
            <TextBlock TextWrapping="Wrap" Opacity="0.8" Margin="0,0,0,8"
                       Text="Approve MDEditor on github.com with a one-time code. Recommended - no token to copy or manage." />
            <Button x:Name="DeviceFlowButton" Content="Sign in with Browser..." Padding="12,3" HorizontalAlignment="Left"
                    Margin="0,0,0,8" Click="DeviceFlow_Click" />

            <Border x:Name="DeviceFlowPanel" Visibility="Collapsed" BorderThickness="1" Padding="12" Margin="0,0,0,8"
                    BorderBrush="{DynamicResource AppBorderBrush}" Background="{DynamicResource ControlBackgroundBrush}">
                <StackPanel>
                    <TextBlock Text="Enter this code on GitHub:" Margin="0,0,0,4" />
                    <TextBox x:Name="UserCodeText" IsReadOnly="True" FontFamily="Cascadia Code, Consolas, monospace"
                             FontSize="22" FontWeight="Bold" BorderThickness="0" Background="Transparent"
                             Foreground="{DynamicResource ControlForegroundBrush}" Margin="0,0,0,8" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="Copy Code &amp; Open GitHub" Padding="12,3" Margin="0,0,8,0" Click="CopyAndOpen_Click" />
                        <Button Content="Cancel" Padding="12,3" Click="CancelDeviceFlow_Click" />
                    </StackPanel>
                    <TextBlock x:Name="DeviceFlowStatusText" Text="Waiting for you to approve on GitHub..." Opacity="0.8" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <TextBlock Text="Personal Access Token" FontWeight="SemiBold" Margin="0,12,0,4" />
            <TextBlock TextWrapping="Wrap" Opacity="0.8" Margin="0,0,0,8">
                <Run Text="Classic tokens need the" />
                <Run Text="repo" FontFamily="Consolas" />
                <Run Text="scope (plus" />
                <Run Text="gist" FontFamily="Consolas" />
                <Run Text="for gists). Fine-grained tokens need Contents: Read and write." />
                <Hyperlink x:Name="CreateTokenLink" Click="CreateTokenLink_Click">Create a token on GitHub</Hyperlink>
            </TextBlock>
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <PasswordBox x:Name="TokenBox" VerticalContentAlignment="Center" Margin="0,0,8,0" KeyDown="TokenBox_KeyDown"
                             Background="{DynamicResource ControlBackgroundBrush}" Foreground="{DynamicResource ControlForegroundBrush}" />
                <Button x:Name="AddTokenButton" Grid.Column="1" Content="Add Token" Padding="12,3" Click="AddToken_Click" />
            </Grid>

            <TextBlock x:Name="StatusText" TextWrapping="Wrap" Margin="0,4,0,12" Visibility="Collapsed" />

            <Expander Header="Advanced" Margin="0,8,0,0">
                <StackPanel Margin="0,8,0,0">
                    <TextBlock Text="OAuth App Client ID override (leave as-is unless you use your own OAuth App)" TextWrapping="Wrap" Margin="0,0,0,4" />
                    <TextBox x:Name="ClientIdBox" LostFocus="ClientIdBox_LostFocus"
                             Background="{DynamicResource ControlBackgroundBrush}" Foreground="{DynamicResource ControlForegroundBrush}" />
                    <TextBlock TextWrapping="Wrap" Opacity="0.7" Margin="0,4,0,0"
                               Text="Register an OAuth App on GitHub (Settings > Developer settings) with &quot;Enable Device Flow&quot; checked, then paste its Client ID here. Tokens are stored in Windows Credential Manager." />
                </StackPanel>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</Window>
