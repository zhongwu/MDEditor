<Window x:Class="MDEditor.GitHubConflictDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="File Changed on GitHub" Width="480" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource WindowForegroundBrush}">
    <StackPanel Margin="16">
        <TextBlock x:Name="HeadlineText" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,6" />
        <TextBlock TextWrapping="Wrap" Opacity="0.85" Margin="0,0,0,16"
                   Text="Someone committed a newer version of this file after you opened it. How do you want to save your changes?" />

        <Button x:Name="NewBranchButton" HorizontalContentAlignment="Left" Padding="10,6" Margin="0,0,0,8" Click="NewBranch_Click">
            <StackPanel>
                <TextBlock Text="Commit to a new branch (recommended)" FontWeight="SemiBold" />
                <TextBlock Text="Keeps both versions; open a pull request to merge them on GitHub." Opacity="0.8" TextWrapping="Wrap" />
            </StackPanel>
        </Button>
        <Button HorizontalContentAlignment="Left" Padding="10,6" Margin="0,0,0,8" Click="Overwrite_Click">
            <StackPanel>
                <TextBlock Text="Overwrite with my version" FontWeight="SemiBold" />
                <TextBlock Text="Replaces their changes on the branch with your text." Opacity="0.8" TextWrapping="Wrap" />
            </StackPanel>
        </Button>
        <Button HorizontalContentAlignment="Left" Padding="10,6" Margin="0,0,0,8" Click="LoadTheirs_Click">
            <StackPanel>
                <TextBlock Text="Discard my changes and load theirs" FontWeight="SemiBold" />
                <TextBlock Text="Replaces the editor's text with the latest version from GitHub." Opacity="0.8" TextWrapping="Wrap" />
            </StackPanel>
        </Button>

        <DockPanel Margin="0,8,0,0">
            <Button DockPanel.Dock="Right" Content="Cancel" IsCancel="True" Padding="16,3" />
            <TextBlock VerticalAlignment="Center">
                <Hyperlink x:Name="ViewLink" Click="ViewLink_Click">See the latest version on GitHub</Hyperlink>
            </TextBlock>
        </DockPanel>
    </StackPanel>
</Window>
