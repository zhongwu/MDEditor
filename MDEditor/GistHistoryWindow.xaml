<Window x:Class="MDEditor.GistHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:MDEditor.Localization"
        Title="{loc:Tr Gist_HistoryTitle}" Height="620" Width="1000" MinHeight="400" MinWidth="640"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource WindowForegroundBrush}">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" MinWidth="200" />
            <ColumnDefinition Width="6" />
            <ColumnDefinition Width="*" MinWidth="300" />
        </Grid.ColumnDefinitions>

        <TextBlock x:Name="HeaderText" Grid.Row="0" Grid.Column="0" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                   VerticalAlignment="Center" Margin="0,0,0,6" />
        <ListBox x:Name="RevisionList" Grid.Row="1" Grid.Column="0" HorizontalContentAlignment="Stretch"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 Background="{DynamicResource ControlBackgroundBrush}" Foreground="{DynamicResource ControlForegroundBrush}"
                 SelectionChanged="RevisionList_SelectionChanged" />

        <GridSplitter Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent" />

        <DockPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,6">
            <TextBlock x:Name="StatsText" DockPanel.Dock="Right" VerticalAlignment="Center" FontFamily="Cascadia Code, Consolas, monospace" />
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <RadioButton x:Name="RevisionChangesRadio" GroupName="Compare" Content="{loc:Tr Gist_ChangesInRevision}" IsChecked="True"
                             Margin="0,0,12,0" Checked="CompareMode_Changed" />
                <RadioButton x:Name="VsCurrentRadio" GroupName="Compare" Content="{loc:Tr GH_VsCurrent}"
                             Margin="0,0,12,0" Checked="CompareMode_Changed" />
                <CheckBox x:Name="FullFileCheck" Content="{loc:Tr GH_ShowWholeFile}" Checked="CompareMode_Changed" Unchecked="CompareMode_Changed" />
            </StackPanel>
        </DockPanel>
        <Grid Grid.Row="1" Grid.Column="2">
            <ListBox x:Name="DiffList" FontFamily="Cascadia Code, Consolas, monospace" FontSize="12"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                     HorizontalContentAlignment="Stretch"
                     Background="{DynamicResource EditorBackgroundBrush}" Foreground="{DynamicResource EditorForegroundBrush}">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="Focusable" Value="False" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Background="{Binding Background}" Opacity="{Binding Opacity}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="44" />
                                <ColumnDefinition Width="44" />
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding OldNumber}" TextAlignment="Right" Opacity="0.55" Margin="0,0,6,0" />
                            <TextBlock Grid.Column="1" Text="{Binding NewNumber}" TextAlignment="Right" Opacity="0.55" Margin="0,0,6,0" />
                            <TextBlock Grid.Column="2" Text="{Binding Marker}" FontWeight="Bold" />
                            <TextBlock Grid.Column="3" Text="{Binding Text}" FontStyle="{Binding FontStyle}" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock x:Name="DiffPlaceholder" Text="{loc:Tr GH_LoadingHistory}" Opacity="0.7" TextWrapping="Wrap" TextAlignment="Center"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16" IsHitTestVisible="False" />
        </Grid>

        <DockPanel Grid.Row="2" Grid.ColumnSpan="3" Margin="0,10,0,0">
            <Button DockPanel.Dock="Right" Content="{loc:Tr Common_Close}" IsCancel="True" Padding="16,3" Margin="8,0,0,0" />
            <Button x:Name="RestoreButton" DockPanel.Dock="Right" Content="{loc:Tr GH_RestoreVersion}" Padding="16,3" Margin="8,0,0,0"
                    IsEnabled="False" Click="Restore_Click"
                    AutomationProperties.Name="{loc:Tr Gist_RestoreTip}" ToolTip="{loc:Tr Gist_RestoreTip}" />
            <Button x:Name="ViewOnGitHubButton" DockPanel.Dock="Right" Content="{loc:Tr Gist_ViewRevision}" Padding="16,3"
                    IsEnabled="False" Click="ViewOnGitHub_Click" />
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Opacity="0.8" />
        </DockPanel>
    </Grid>
</Window>
