<Window x:Class="MDEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:wpf="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:editor="clr-namespace:MDEditor.Editor"
        Title="MDEditor" Height="600" Width="1000"
        mc:Ignorable="d">
    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Menu x:Name="MainMenuBar" Grid.Row="0">
            <MenuItem Header="File">
                <MenuItem Header="New" Command="{Binding NewFileCommand}" />
                <MenuItem Header="Open..." Command="{Binding OpenFileCommand}" />
                <MenuItem Header="Recent Files" Name="RecentFilesMenu">
                    <MenuItem Header="(No recent files)" IsEnabled="False" />
                </MenuItem>
                <Separator />
                <MenuItem Header="Save" Command="{Binding SaveFileCommand}" />
                <MenuItem Header="Save As..." Command="{Binding SaveAsFileCommand}" />
                <Separator />
                <MenuItem Header="Export HTML" Command="{Binding ExportHtmlCommand}" />
                <MenuItem Header="Export PDF" Command="{Binding ExportPdfCommand}" />
                <Separator />
                <MenuItem Header="Exit" Command="{Binding ExitCommand}" />
            </MenuItem>
            <MenuItem Header="Edit">
                <MenuItem Header="Undo" Command="{Binding UndoCommand}" />
                <MenuItem Header="Redo" Command="{Binding RedoCommand}" />
                <Separator />
                <MenuItem Header="Cut" Command="{Binding CutCommand}" />
                <MenuItem Header="Copy" Command="{Binding CopyCommand}" />
                <MenuItem Header="Paste" Command="{Binding PasteCommand}" />
                <Separator />
                <MenuItem Header="Find" Command="{Binding FindCommand}" />
                <MenuItem Header="Replace" Command="{Binding ReplaceCommand}" />
                <MenuItem Header="Go to Line..." Command="{Binding GoToLineCommand}" />
                <Separator />
                <MenuItem Header="Select All" Command="{Binding SelectAllCommand}" />
            </MenuItem>
            <MenuItem Header="View">
                <MenuItem Header="Toggle Preview" Command="{Binding TogglePreviewCommand}" />
                <MenuItem Header="Toggle Line Numbers" Command="{Binding ToggleLineNumbersCommand}" />
                <MenuItem Header="Word Wrap" Command="{Binding ToggleWordWrapCommand}" />
                <Separator />
                <MenuItem Header="Zoom In" Command="{Binding ZoomInCommand}" />
                <MenuItem Header="Zoom Out" Command="{Binding ZoomOutCommand}" />
                <MenuItem Header="Reset Zoom" Command="{Binding ResetZoomCommand}" />
                <Separator />
                <MenuItem Header="Theme" Command="{Binding CycleThemeCommand}" />
            </MenuItem>
            <MenuItem Header="Format">
                <MenuItem Header="Heading 1" Command="{Binding Heading1Command}" />
                <MenuItem Header="Heading 2" Command="{Binding Heading2Command}" />
                <MenuItem Header="Heading 3" Command="{Binding Heading3Command}" />
                <MenuItem Header="Heading 4" Command="{Binding Heading4Command}" />
                <MenuItem Header="Heading 5" Command="{Binding Heading5Command}" />
                <MenuItem Header="Heading 6" Command="{Binding Heading6Command}" />
                <Separator />
                <MenuItem Header="Bold" Command="{Binding BoldCommand}" />
                <MenuItem Header="Italic" Command="{Binding ItalicCommand}" />
                <MenuItem Header="Strikethrough" Command="{Binding StrikethroughCommand}" />
                <MenuItem Header="Inline Code" Command="{Binding InlineCodeCommand}" />
                <Separator />
                <MenuItem Header="Code Block" Command="{Binding CodeBlockCommand}" />
                <MenuItem Header="Blockquote" Command="{Binding BlockquoteCommand}" />
                <Separator />
                <MenuItem Header="Unordered List" Command="{Binding UnorderedListCommand}" />
                <MenuItem Header="Ordered List" Command="{Binding OrderedListCommand}" />
                <MenuItem Header="Task List" Command="{Binding TaskListCommand}" />
                <Separator />
                <MenuItem Header="Link" Command="{Binding InsertLinkCommand}" />
                <MenuItem Header="Image" Command="{Binding InsertImageCommand}" />
                <MenuItem Header="Table" Command="{Binding InsertTableCommand}" />
                <MenuItem Header="Horizontal Rule" Command="{Binding InsertHorizontalRuleCommand}" />
                <MenuItem Header="Math Block" Command="{Binding MathBlockCommand}" />
            </MenuItem>
            <MenuItem Header="Tools">
                <MenuItem x:Name="SmartTypographyMenuItem"
                          Header="Smart Typography"
                          IsCheckable="True"
                          IsChecked="True"
                          Click="SmartTypography_Click" />
                <Separator />
                <MenuItem Header="GitHub Sync" Command="{Binding GitHubSyncCommand}" />
                <MenuItem Header="Settings" Command="{Binding SettingsCommand}" />
            </MenuItem>
            <MenuItem Header="Help">
                <MenuItem Header="Keyboard Shortcuts" Command="{Binding KeyboardShortcutsCommand}" />
                <MenuItem Header="Markdown Guide" Command="{Binding MarkdownGuideCommand}" />
                <Separator />
                <MenuItem Header="About" Command="{Binding AboutCommand}" />
            </MenuItem>
        </Menu>

        <ToolBar x:Name="MainCommandBar" Grid.Row="1">
            <Button Command="{Binding NewFileCommand}" ToolTip="New (Ctrl+N)">
                <Button.Content>
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8A5;" />
                </Button.Content>
            </Button>
            <Button Command="{Binding OpenFileCommand}" ToolTip="Open (Ctrl+O)">
                <Button.Content>
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8E5;" />
                </Button.Content>
            </Button>
            <Button Command="{Binding SaveFileCommand}" ToolTip="Save (Ctrl+S)">
                <Button.Content>
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE74E;" />
                </Button.Content>
            </Button>
            <Separator />
            <Button Command="{Binding UndoCommand}" ToolTip="Undo (Ctrl+Z)">
                <Button.Content>
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE7A7;" />
                </Button.Content>
            </Button>
            <Button Command="{Binding RedoCommand}" ToolTip="Redo (Ctrl+Y)">
                <Button.Content>
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE7A6;" />
                </Button.Content>
            </Button>
            <Separator />
            <Button Command="{Binding BoldCommand}" ToolTip="Bold (Ctrl+B)">
                <Button.Content>
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8DD;" />
                </Button.Content>
            </Button>
            <Button Command="{Binding ItalicCommand}" ToolTip="Italic (Ctrl+I)">
                <Button.Content>
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8DB;" />
                </Button.Content>
            </Button>
            <Button Command="{Binding StrikethroughCommand}" ToolTip="Strikethrough (Ctrl+Shift+X)">
                <Button.Content>
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xEDE0;" />
                </Button.Content>
            </Button>
            <Button Command="{Binding InlineCodeCommand}" ToolTip="Inline Code (Ctrl+`)">
                <Button.Content>
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE943;" />
                </Button.Content>
            </Button>
            <Separator />
            <Button Command="{Binding CodeBlockCommand}" ToolTip="Code Block (Ctrl+Shift+C)">
                <Button.Content>
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE943;" VerticalAlignment="Bottom" />
                </Button.Content>
            </Button>
            <Button Command="{Binding BlockquoteCommand}" ToolTip="Blockquote (Ctrl+Q)">
                <Button.Content>
                    <TextBlock Text="&gt;" />
                </Button.Content>
            </Button>
            <Separator />
            <Button Command="{Binding Heading1Command}" ToolTip="Heading 1 (Ctrl+1)">
                <Button.Content>
                    <TextBlock Text="H1" />
                </Button.Content>
            </Button>
            <Button Command="{Binding Heading2Command}" ToolTip="Heading 2 (Ctrl+2)">
                <Button.Content>
                    <TextBlock Text="H2" />
                </Button.Content>
            </Button>
            <Button Command="{Binding Heading3Command}" ToolTip="Heading 3 (Ctrl+3)">
                <Button.Content>
                    <TextBlock Text="H3" />
                </Button.Content>
            </Button>
            <Separator />
            <Button Command="{Binding UnorderedListCommand}" ToolTip="Unordered List (Ctrl+Shift+L)">
                <Button.Content>
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8FD;" />
                </Button.Content>
            </Button>
            <Button Command="{Binding OrderedListCommand}" ToolTip="Ordered List (Ctrl+Shift+O)">
                <Button.Content>
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8FD;" />
                </Button.Content>
            </Button>
            <Button Command="{Binding TaskListCommand}" ToolTip="Task List (Ctrl+Shift+T)">
                <Button.Content>
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE73E;" />
                </Button.Content>
            </Button>
            <Separator />
            <Button Command="{Binding InsertLinkCommand}" ToolTip="Insert Link (Ctrl+K)">
                <Button.Content>
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE71B;" />
                </Button.Content>
            </Button>
            <Button Command="{Binding InsertImageCommand}" ToolTip="Insert Image (Ctrl+Shift+I)">
                <Button.Content>
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8B9;" />
                </Button.Content>
            </Button>
            <Button Command="{Binding InsertTableCommand}" ToolTip="Insert Table (Ctrl+Shift+T)">
                <Button.Content>
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8F1;" />
                </Button.Content>
            </Button>
            <Separator />
            <Button Command="{Binding TogglePreviewCommand}" ToolTip="Toggle Preview (Ctrl+Shift+P)">
                <Button.Content>
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8A1;" />
                </Button.Content>
            </Button>
        </ToolBar>

        <Grid x:Name="MainContentGrid" Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="EditorColumn" Width="*" MinWidth="300" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="PreviewColumn" Width="*" MinWidth="300" />
            </Grid.ColumnDefinitions>

            <Grid x:Name="EditorPane" Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}" BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}" BorderThickness="0,0,0,1" Padding="8,4">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="EDITOR" FontSize="12" Foreground="Gray" VerticalAlignment="Center" />
                        <TextBlock x:Name="EditorFileName" Text="Untitled.md" VerticalAlignment="Center" Margin="8,0,0,0" />
                        <TextBlock x:Name="EditorDirtyIndicator" Text="●" FontSize="12" Foreground="Red" VerticalAlignment="Center" Margin="4,0,0,0" Visibility="Collapsed" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}" BorderThickness="1" Margin="8" CornerRadius="4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ScrollViewer x:Name="LineNumbersScrollViewer"
                                      Grid.Column="0"
                                      VerticalScrollBarVisibility="Hidden"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Visibility="Collapsed">
                            <TextBlock x:Name="LineNumbers"
                                       FontFamily="Cascadia Code, Consolas, monospace"
                                       FontSize="14"
                                       Foreground="Gray"
                                       Padding="8,0,8,0"
                                       TextAlignment="Right"
                                       LineHeight="18"
                                       LineStackingStrategy="BlockLineHeight" />
                        </ScrollViewer>
                        <Grid Grid.Column="1">
                        <RichTextBox x:Name="MarkdownEditor"
                                     FontFamily="Cascadia Code, Consolas, monospace"
                                     FontSize="14"
                                     AcceptsReturn="True"
                                     Padding="4,0,4,0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     TextChanged="MarkdownEditor_TextChanged">
                            <RichTextBox.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Undo" Command="{Binding UndoCommand}" />
                                    <MenuItem Header="Redo" Command="{Binding RedoCommand}" />
                                    <Separator />
                                    <MenuItem Header="Cut" Command="{Binding CutCommand}" />
                                    <MenuItem Header="Copy" Command="{Binding CopyCommand}" />
                                    <MenuItem Header="Paste" Command="{Binding PasteCommand}" />
                                    <Separator />
                                    <MenuItem Header="Bold" Command="{Binding BoldCommand}" />
                                    <MenuItem Header="Italic" Command="{Binding ItalicCommand}" />
                                    <MenuItem Header="Strikethrough" Command="{Binding StrikethroughCommand}" />
                                    <MenuItem Header="Inline Code" Command="{Binding InlineCodeCommand}" />
                                    <Separator />
                                    <MenuItem Header="Heading 1" Command="{Binding Heading1Command}" />
                                    <MenuItem Header="Heading 2" Command="{Binding Heading2Command}" />
                                    <MenuItem Header="Heading 3" Command="{Binding Heading3Command}" />
                                    <Separator />
                                    <MenuItem Header="Code Block" Command="{Binding CodeBlockCommand}" />
                                    <MenuItem Header="Blockquote" Command="{Binding BlockquoteCommand}" />
                                    <Separator />
                                    <MenuItem Header="Unordered List" Command="{Binding UnorderedListCommand}" />
                                    <MenuItem Header="Ordered List" Command="{Binding OrderedListCommand}" />
                                    <MenuItem Header="Task List" Command="{Binding TaskListCommand}" />
                                    <Separator />
                                    <MenuItem Header="Insert Link" Command="{Binding InsertLinkCommand}" />
                                    <MenuItem Header="Insert Image" Command="{Binding InsertImageCommand}" />
                                    <MenuItem Header="Insert Table" Command="{Binding InsertTableCommand}" />
                                    <MenuItem Header="Insert Horizontal Rule" Command="{Binding InsertHorizontalRuleCommand}" />
                                    <Separator />
                                    <MenuItem Header="Select All" Command="{Binding SelectAllCommand}" />
                                    <Separator />
                                    <MenuItem Header="Copy as Markdown" Click="CopyAsMarkdown_Click" />
                                    <MenuItem Header="Copy as HTML" Click="CopyAsHtml_Click" />
                                </ContextMenu>
                            </RichTextBox.ContextMenu>
                        </RichTextBox>
                        <editor:BracketHighlightOverlay x:Name="BracketOverlay"
                                                        IsHitTestVisible="False"
                                                        Panel.ZIndex="99" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <GridSplitter x:Name="SplitterColumn" Grid.Column="1" Width="6" Background="Transparent" />

            <Grid x:Name="PreviewPane" Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}" BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}" BorderThickness="0,0,0,1" Padding="8,4">
                    <TextBlock Text="PREVIEW" FontSize="12" Foreground="Gray" VerticalAlignment="Center" />
                </Border>

                <Border Grid.Row="1" BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}" BorderThickness="1" Margin="8" CornerRadius="4">
                    <wpf:WebView2 x:Name="MarkdownPreview"
                                  NavigationStarting="MarkdownPreview_NavigationStarting" />
                </Border>
            </Grid>
        </Grid>

        <StatusBar Grid.Row="3" Height="28" Background="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}" BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}" BorderThickness="0,1,0,0">
            <StatusBarItem>
                <TextBlock x:Name="StatusCursorPosition" Text="Ln 1, Col 1" VerticalAlignment="Center" Margin="12,0" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock x:Name="StatusFileEncoding" Text="UTF-8" VerticalAlignment="Center" Margin="0,0,12,0" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock x:Name="StatusWordCount" Text="Words: 0" VerticalAlignment="Center" Margin="0,0,12,0" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock x:Name="StatusLineEnding" Text="LF" VerticalAlignment="Center" Margin="0,0,12,0" />
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <ComboBox x:Name="StatusZoomCombo" Width="80" Margin="0,0,12,0" VerticalAlignment="Center" SelectionChanged="StatusZoomCombo_SelectionChanged">
                    <ComboBoxItem Content="50%" Tag="0.5" />
                    <ComboBoxItem Content="75%" Tag="0.75" />
                    <ComboBoxItem Content="100%" Tag="1.0" IsSelected="True" />
                    <ComboBoxItem Content="125%" Tag="1.25" />
                    <ComboBoxItem Content="150%" Tag="1.5" />
                    <ComboBoxItem Content="200%" Tag="2.0" />
                </ComboBox>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>