<Window x:Class="MDEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:wpf="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:editor="clr-namespace:MDEditor.Editor"
        Title="MDEditor" Height="600" Width="1000"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource WindowForegroundBrush}"
        mc:Ignorable="d">

    <Window.InputBindings>
        <KeyBinding Key="E" Modifiers="Control+Shift" Command="{Binding ToggleOutlineCommand}" />
        <KeyBinding Key="F" Modifiers="Control" Command="{Binding FindCommand}" />
        <KeyBinding Key="H" Modifiers="Control" Command="{Binding ReplaceCommand}" />
        <KeyBinding Key="G" Modifiers="Control" Command="{Binding GoToLineCommand}" />
        <KeyBinding Key="F" Modifiers="Control+Shift" Command="{Binding FindInPreviewCommand}" />
        <KeyBinding Key="P" Modifiers="Control" Command="{Binding PrintPreviewCommand}" />
        <KeyBinding Key="F5" Command="{Binding PresentationModeCommand}" />
        <KeyBinding Key="OemPlus" Modifiers="Control" Command="{Binding ZoomInCommand}" />
        <KeyBinding Key="Add" Modifiers="Control" Command="{Binding ZoomInCommand}" />
        <KeyBinding Key="OemMinus" Modifiers="Control" Command="{Binding ZoomOutCommand}" />
        <KeyBinding Key="Subtract" Modifiers="Control" Command="{Binding ZoomOutCommand}" />
        <KeyBinding Key="D0" Modifiers="Control" Command="{Binding ResetZoomCommand}" />
        <KeyBinding Key="NumPad0" Modifiers="Control" Command="{Binding ResetZoomCommand}" />
    </Window.InputBindings>

    <Window.Resources>
        <Style x:Key="PaneHeaderButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="4,1" />
            <Setter Property="Margin" Value="2,0,0,0" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Menu x:Name="MainMenuBar" Grid.Row="0" Background="{DynamicResource ControlBackgroundBrush}">
            <MenuItem Header="File">
                <MenuItem Header="New" Command="{Binding NewFileCommand}" />
                <MenuItem Header="Open..." Command="{Binding OpenFileCommand}" />
                <MenuItem Header="Open from GitHub..." Command="{Binding OpenFromGitHubCommand}" />
                <MenuItem Header="Recent Files" Name="RecentFilesMenu">
                    <MenuItem Header="(No recent files)" IsEnabled="False" />
                </MenuItem>
                <Separator />
                <MenuItem Header="Save" Command="{Binding SaveFileCommand}" />
                <MenuItem Header="Save As..." Command="{Binding SaveAsFileCommand}" />
                <Separator />
                <MenuItem Header="Export HTML" Command="{Binding ExportHtmlCommand}" />
                <MenuItem Header="Export PDF" Command="{Binding ExportPdfCommand}" />
                <Separator />
                <MenuItem Header="Print Preview..." Command="{Binding PrintPreviewCommand}" InputGestureText="Ctrl+P" />
                <Separator />
                <MenuItem Header="Exit" Command="{Binding ExitCommand}" />
            </MenuItem>
            <MenuItem Header="Edit">
                <MenuItem Header="Undo" Command="{Binding UndoCommand}" />
                <MenuItem Header="Redo" Command="{Binding RedoCommand}" />
                <Separator />
                <MenuItem Header="Cut" Command="{Binding CutCommand}" />
                <MenuItem Header="Copy" Command="{Binding CopyCommand}" />
                <MenuItem Header="Paste" Command="{Binding PasteCommand}" />
                <Separator />
                <MenuItem Header="Find" Command="{Binding FindCommand}" InputGestureText="Ctrl+F" />
                <MenuItem Header="Replace" Command="{Binding ReplaceCommand}" InputGestureText="Ctrl+H" />
                <MenuItem Header="Find in Preview" Command="{Binding FindInPreviewCommand}" InputGestureText="Ctrl+Shift+F" />
                <MenuItem Header="Go to Line..." Command="{Binding GoToLineCommand}" InputGestureText="Ctrl+G" />
                <Separator />
                <MenuItem Header="Select All" Command="{Binding SelectAllCommand}" />
            </MenuItem>
            <MenuItem Header="View">
                <MenuItem x:Name="PreviewMenuItem" Header="Show Preview" Command="{Binding TogglePreviewCommand}" IsCheckable="True" />
                <MenuItem x:Name="EditorMenuItem" Header="Show Editor" Command="{Binding ToggleEditorCommand}" IsCheckable="True" />
                <MenuItem x:Name="OutlineMenuItem" Header="Show Outline" Command="{Binding ToggleOutlineCommand}" IsCheckable="True" InputGestureText="Ctrl+Shift+E" />
                <MenuItem x:Name="LineNumbersMenuItem" Header="Show Line Numbers" Command="{Binding ToggleLineNumbersCommand}" IsCheckable="True" />
                <MenuItem x:Name="MinimapMenuItem" Header="Show Minimap" Click="ToggleMinimap_Click" IsCheckable="True" />
                <MenuItem x:Name="ScrollSyncMenuItem" Header="Show Scroll Sync" Click="ToggleScrollSync_Click" IsCheckable="True" />
                <MenuItem Header="Word Wrap" Command="{Binding ToggleWordWrapCommand}" />
                <Separator />
                <MenuItem Header="Zoom In" Command="{Binding ZoomInCommand}" InputGestureText="Ctrl++" />
                <MenuItem Header="Zoom Out" Command="{Binding ZoomOutCommand}" InputGestureText="Ctrl+-" />
                <MenuItem Header="Reset Zoom" Command="{Binding ResetZoomCommand}" InputGestureText="Ctrl+0" />
                <Separator />
                <MenuItem Header="Presentation Mode" Command="{Binding PresentationModeCommand}" InputGestureText="F5" />
            </MenuItem>
            <MenuItem Header="Format">
                <MenuItem Header="Heading 1" Command="{Binding Heading1Command}" />
                <MenuItem Header="Heading 2" Command="{Binding Heading2Command}" />
                <MenuItem Header="Heading 3" Command="{Binding Heading3Command}" />
                <MenuItem Header="Heading 4" Command="{Binding Heading4Command}" />
                <MenuItem Header="Heading 5" Command="{Binding Heading5Command}" />
                <MenuItem Header="Heading 6" Command="{Binding Heading6Command}" />
                <Separator />
                <MenuItem Header="Bold" Command="{Binding BoldCommand}" />
                <MenuItem Header="Italic" Command="{Binding ItalicCommand}" />
                <MenuItem Header="Strikethrough" Command="{Binding StrikethroughCommand}" />
                <MenuItem Header="Inline Code" Command="{Binding InlineCodeCommand}" />
                <Separator />
                <MenuItem Header="Code Block" Command="{Binding CodeBlockCommand}" />
                <MenuItem Header="Blockquote" Command="{Binding BlockquoteCommand}" />
                <Separator />
                <MenuItem Header="Unordered List" Command="{Binding UnorderedListCommand}" />
                <MenuItem Header="Ordered List" Command="{Binding OrderedListCommand}" />
                <MenuItem Header="Task List" Command="{Binding TaskListCommand}" />
                <Separator />
                <MenuItem Header="Link" Command="{Binding InsertLinkCommand}" />
                <MenuItem Header="Image" Command="{Binding InsertImageCommand}" />
                <MenuItem Header="Table" Command="{Binding InsertTableCommand}" />
                <MenuItem Header="Horizontal Rule" Command="{Binding InsertHorizontalRuleCommand}" />
                <MenuItem Header="Math Block" Command="{Binding MathBlockCommand}" />
            </MenuItem>
            <MenuItem Header="Tools">
                <MenuItem x:Name="SmartTypographyMenuItem"
                          Header="Smart Typography"
                          IsCheckable="True"
                          IsChecked="True"
                          Click="SmartTypography_Click" />
                <Separator />
                <MenuItem Header="GitHub Accounts..." Command="{Binding GitHubAccountsCommand}" />
                <MenuItem Header="Commit to GitHub..." Command="{Binding GitHubSyncCommand}"
                          Visibility="{Binding IsGitHubDocument, Converter={StaticResource BoolToVisibility}}" />
                <MenuItem Header="File History (GitHub)..." Command="{Binding GitHubHistoryCommand}"
                          Visibility="{Binding IsGitHubDocument, Converter={StaticResource BoolToVisibility}}" />
                <MenuItem Header="Settings" Command="{Binding SettingsCommand}" />
            </MenuItem>
            <MenuItem Header="Help">
                <MenuItem Header="Keyboard Shortcuts" Command="{Binding KeyboardShortcutsCommand}" />
                <MenuItem Header="Markdown Guide" Command="{Binding MarkdownGuideCommand}" />
                <Separator />
                <MenuItem Header="About" Command="{Binding AboutCommand}" />
            </MenuItem>
        </Menu>

        <ToolBar x:Name="MainCommandBar" Grid.Row="1" Background="{DynamicResource ControlBackgroundBrush}">
            <Button Command="{Binding NewFileCommand}" ToolTip="New (Ctrl+N)">
                <Button.Content>
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8A5;" />
                </Button.Content>
            </Button>
            <Button Command="{Binding OpenFileCommand}" ToolTip="Open (Ctrl+O)">
                <Button.Content>
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8E5;" />
                </Button.Content>
            </Button>
            <Button Command="{Binding SaveFileCommand}" ToolTip="Save (Ctrl+S)">
                <Button.Content>
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE74E;" />
                </Button.Content>
            </Button>
            <Separator />
            <Button Command="{Binding UndoCommand}" ToolTip="Undo (Ctrl+Z)">
                <Button.Content>
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE7A7;" />
                </Button.Content>
            </Button>
            <Button Command="{Binding RedoCommand}" ToolTip="Redo (Ctrl+Y)">
                <Button.Content>
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE7A6;" />
                </Button.Content>
            </Button>
            <Separator />
            <Button Command="{Binding BoldCommand}" ToolTip="Bold (Ctrl+B)">
                <Button.Content>
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8DD;" />
                </Button.Content>
            </Button>
            <Button Command="{Binding ItalicCommand}" ToolTip="Italic (Ctrl+I)">
                <Button.Content>
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8DB;" />
                </Button.Content>
            </Button>
            <Button Command="{Binding StrikethroughCommand}" ToolTip="Strikethrough (Ctrl+Shift+X)">
                <Button.Content>
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xEDE0;" />
                </Button.Content>
            </Button>
            <Button Command="{Binding InlineCodeCommand}" ToolTip="Inline Code (Ctrl+`)">
                <Button.Content>
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE943;" />
                </Button.Content>
            </Button>
            <Separator />
            <Button Command="{Binding CodeBlockCommand}" ToolTip="Code Block (Ctrl+Shift+C)">
                <Button.Content>
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE943;" VerticalAlignment="Bottom" />
                </Button.Content>
            </Button>
            <Button Command="{Binding BlockquoteCommand}" ToolTip="Blockquote (Ctrl+Q)">
                <Button.Content>
                    <TextBlock Text="&gt;" />
                </Button.Content>
            </Button>
            <Separator />
            <Button Command="{Binding Heading1Command}" ToolTip="Heading 1 (Ctrl+1)">
                <Button.Content>
                    <TextBlock Text="H1" />
                </Button.Content>
            </Button>
            <Button Command="{Binding Heading2Command}" ToolTip="Heading 2 (Ctrl+2)">
                <Button.Content>
                    <TextBlock Text="H2" />
                </Button.Content>
            </Button>
            <Button Command="{Binding Heading3Command}" ToolTip="Heading 3 (Ctrl+3)">
                <Button.Content>
                    <TextBlock Text="H3" />
                </Button.Content>
            </Button>
            <Separator />
            <Button Command="{Binding UnorderedListCommand}" ToolTip="Unordered List (Ctrl+Shift+L)">
                <Button.Content>
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8FD;" />
                </Button.Content>
            </Button>
            <Button Command="{Binding OrderedListCommand}" ToolTip="Ordered List (Ctrl+Shift+O)">
                <Button.Content>
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8FD;" />
                </Button.Content>
            </Button>
            <Button Command="{Binding TaskListCommand}" ToolTip="Task List (Ctrl+Shift+T)">
                <Button.Content>
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE73E;" />
                </Button.Content>
            </Button>
            <Separator />
            <Button Command="{Binding InsertLinkCommand}" ToolTip="Insert Link (Ctrl+K)">
                <Button.Content>
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE71B;" />
                </Button.Content>
            </Button>
            <Button Command="{Binding InsertImageCommand}" ToolTip="Insert Image (Ctrl+Shift+I)">
                <Button.Content>
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8B9;" />
                </Button.Content>
            </Button>
            <Button Command="{Binding InsertTableCommand}" ToolTip="Insert Table (Ctrl+Shift+T)">
                <Button.Content>
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8F1;" />
                </Button.Content>
            </Button>
            <Separator />
            <Button Command="{Binding TogglePreviewCommand}" ToolTip="Toggle Preview (Ctrl+Shift+P)">
                <Button.Content>
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8A1;" />
                </Button.Content>
            </Button>
            <Button Command="{Binding ToggleEditorCommand}" ToolTip="Toggle Editor">
                <Button.Content>
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE70F;" />
                </Button.Content>
            </Button>
            <Button Command="{Binding ToggleOutlineCommand}" ToolTip="Toggle Outline (Ctrl+Shift+E)">
                <Button.Content>
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE700;" />
                </Button.Content>
            </Button>
            <Button Command="{Binding FindInPreviewCommand}" ToolTip="Find in Preview (Ctrl+Shift+F)">
                <Button.Content>
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE721;" />
                </Button.Content>
            </Button>
            <Separator />
            <Button Command="{Binding PrintPreviewCommand}" ToolTip="Print Preview (Ctrl+P)">
                <Button.Content>
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE749;" />
                </Button.Content>
            </Button>
            <Button Command="{Binding PresentationModeCommand}" ToolTip="Presentation Mode (F5)">
                <Button.Content>
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE740;" />
                </Button.Content>
            </Button>
        </ToolBar>

        <Grid x:Name="MainContentGrid" Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="OutlineColumn" Width="Auto" />
                <!--
                    Editor/Preview column widths are managed entirely from code-behind
                    (MainWindow.OnPaneVisibilityChanged) rather than XAML DataTriggers.
                    ColumnDefinition does not reliably participate in DataContext
                    inheritance, so binding-driven triggers here silently failed to
                    reallocate width to the sibling column when one pane was hidden.
                -->
                <ColumnDefinition x:Name="EditorColumn" Width="*" MinWidth="300" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="PreviewColumn" Width="*" MinWidth="300" />
            </Grid.ColumnDefinitions>

            <!-- Outline / TOC panel (collapsible, resizable via the thumb on its right edge) -->
            <Grid x:Name="OutlinePane" Grid.Column="0" Width="240" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}" BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}" BorderThickness="0,0,0,1" Padding="8,4">
                    <DockPanel LastChildFill="False">
                        <TextBlock DockPanel.Dock="Left" Text="OUTLINE" FontSize="12" Foreground="Gray" VerticalAlignment="Center" />
                        <Button DockPanel.Dock="Right" Style="{StaticResource PaneHeaderButton}" Content="&#xE711;" ToolTip="Close Outline (Ctrl+Shift+E)" Command="{Binding ToggleOutlineCommand}" />
                        <Button DockPanel.Dock="Right" Style="{StaticResource PaneHeaderButton}" Content="&#xE70E;" ToolTip="Collapse All" Click="OutlineCollapseAll_Click" />
                        <Button DockPanel.Dock="Right" Style="{StaticResource PaneHeaderButton}" Content="&#xE70D;" ToolTip="Expand All" Click="OutlineExpandAll_Click" />
                    </DockPanel>
                </Border>

                <Border Grid.Row="1" BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}" BorderThickness="1" Margin="8,8,4,8" CornerRadius="4">
                    <Grid>
                        <TreeView x:Name="OutlineTree"
                                  Background="{DynamicResource ControlBackgroundBrush}"
                                  BorderThickness="0"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  PreviewMouseLeftButtonUp="OutlineTree_PreviewMouseLeftButtonUp"
                                  KeyDown="OutlineTree_KeyDown">
                            <TreeView.ItemContainerStyle>
                                <Style TargetType="TreeViewItem">
                                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                    <Setter Property="ToolTip" Value="{Binding Title}" />
                                </Style>
                            </TreeView.ItemContainerStyle>
                            <TreeView.ItemTemplate>
                                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" Padding="2,1">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                        <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HotTrackBrushKey}}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </HierarchicalDataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>
                        <TextBlock x:Name="OutlineEmptyText"
                                   Text="No headings in this document."
                                   Foreground="Gray"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   Margin="12"
                                   VerticalAlignment="Top"
                                   IsHitTestVisible="False" />
                    </Grid>
                </Border>

                <Thumb x:Name="OutlineResizeThumb"
                       Grid.RowSpan="2"
                       Width="5"
                       HorizontalAlignment="Right"
                       Cursor="SizeWE"
                       DragDelta="OutlineResizeThumb_DragDelta"
                       DragCompleted="OutlineResizeThumb_DragCompleted">
                    <Thumb.Template>
                        <ControlTemplate TargetType="Thumb">
                            <Border Background="Transparent" />
                        </ControlTemplate>
                    </Thumb.Template>
                </Thumb>
            </Grid>

            <Grid x:Name="EditorPane" Grid.Column="1">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Opacity" Value="1" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsEditorVisible}" Value="False">
                                <!-- Disable interaction while hidden/faded out -->
                                <Setter Property="IsHitTestVisible" Value="False" />
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.3" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}" BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}" BorderThickness="0,0,0,1" Padding="8,4">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="EDITOR" FontSize="12" Foreground="Gray" VerticalAlignment="Center" />
                        <TextBlock x:Name="EditorFileName" Text="Untitled.md" VerticalAlignment="Center" Margin="8,0,0,0" />
                        <TextBlock x:Name="EditorDirtyIndicator" Text="●" FontSize="12" Foreground="Red" VerticalAlignment="Center" Margin="4,0,0,0" Visibility="Collapsed" />
                    </StackPanel>
                </Border>

                <!-- Find / replace bar for the editor (mirrors the find in preview bar) -->
                <Border x:Name="EditorFindBar" Grid.Row="1" Visibility="Collapsed" Background="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}" BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}" BorderThickness="0,0,0,1" Padding="8,4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Button x:Name="EditorFindToggleReplace" Grid.Row="0" Grid.Column="0" Style="{StaticResource PaneHeaderButton}" Margin="0,0,4,0" Content="&#xE76C;" ToolTip="Toggle Replace (Ctrl+H)" Click="EditorFindToggleReplace_Click" />
                        <TextBox x:Name="EditorFindBox" Grid.Row="0" Grid.Column="1" Background="{DynamicResource ControlBackgroundBrush}" VerticalContentAlignment="Center" Padding="2,1" ToolTip="Find" TextChanged="EditorFindBox_TextChanged" PreviewKeyDown="EditorFindBox_PreviewKeyDown" />
                        <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal">
                            <CheckBox x:Name="EditorFindMatchCase" Content="Aa" ToolTip="Match Case" Margin="8,0,0,0" VerticalAlignment="Center" Click="EditorFindMatchCase_Click" />
                            <TextBlock x:Name="EditorFindStatus" MinWidth="72" Margin="8,0,4,0" TextAlignment="Right" VerticalAlignment="Center" Foreground="Gray" />
                            <Button Style="{StaticResource PaneHeaderButton}" Content="&#xE70E;" ToolTip="Previous Match (Shift+Enter / Shift+F3)" Click="EditorFindPrevious_Click" />
                            <Button Style="{StaticResource PaneHeaderButton}" Content="&#xE70D;" ToolTip="Next Match (Enter / F3)" Click="EditorFindNext_Click" />
                            <Button Style="{StaticResource PaneHeaderButton}" Content="&#xE711;" ToolTip="Close (Esc)" Click="EditorFindClose_Click" />
                        </StackPanel>

                        <TextBox x:Name="EditorReplaceBox" Grid.Row="1" Grid.Column="1" Background="{DynamicResource ControlBackgroundBrush}" Margin="0,4,0,0" Visibility="Collapsed" VerticalContentAlignment="Center" Padding="2,1" ToolTip="Replace" PreviewKeyDown="EditorReplaceBox_PreviewKeyDown" />
                        <StackPanel x:Name="EditorReplaceActions" Grid.Row="1" Grid.Column="2" Orientation="Horizontal" Margin="8,4,0,0" Visibility="Collapsed">
                            <Button Content="Replace" Padding="8,0" Margin="0,0,4,0" ToolTip="Replace (Enter)" Click="EditorReplace_Click" />
                            <Button Content="Replace All" Padding="8,0" ToolTip="Replace All (Ctrl+Enter)" Click="EditorReplaceAll_Click" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Go to line bar (same slot as the find bar; only one is shown at a time) -->
                <Border x:Name="GoToLineBar" Grid.Row="1" Visibility="Collapsed" Background="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}" BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}" BorderThickness="0,0,0,1" Padding="8,4">
                    <DockPanel LastChildFill="True">
                        <Button DockPanel.Dock="Right" Style="{StaticResource PaneHeaderButton}" Content="&#xE711;" ToolTip="Close (Esc)" Click="GoToLineClose_Click" />
                        <TextBlock x:Name="GoToLineStatus" DockPanel.Dock="Right" MinWidth="72" Margin="8,0,4,0" TextAlignment="Right" VerticalAlignment="Center" Foreground="Gray" />
                        <TextBlock DockPanel.Dock="Left" Text="Go to line:" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox x:Name="GoToLineBox" Background="{DynamicResource ControlBackgroundBrush}" VerticalContentAlignment="Center" Padding="2,1" ToolTip="Line number, or line:column" TextChanged="GoToLineBox_TextChanged" PreviewKeyDown="GoToLineBox_PreviewKeyDown" LostKeyboardFocus="GoToLineBox_LostKeyboardFocus" />
                    </DockPanel>
                </Border>

                <Border Grid.Row="2" Background="{DynamicResource EditorBackgroundBrush}" BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}" BorderThickness="1" Margin="8" CornerRadius="4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <editor:LineNumberGutter x:Name="LineNumberGutter"
                                                 Grid.Column="0"
                                                 Visibility="Collapsed" />
                        <Grid Grid.Column="1">
                            <RichTextBox x:Name="MarkdownEditor"
                                     Background="{DynamicResource EditorBackgroundBrush}"
                                     Foreground="{DynamicResource EditorForegroundBrush}"
                                     CaretBrush="{DynamicResource EditorForegroundBrush}"
                                     BorderThickness="0"
                                     FontFamily="Cascadia Code, Consolas, monospace"
                                     FontSize="14"
                                     AcceptsReturn="True"
                                     Padding="4,0,4,0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     TextChanged="MarkdownEditor_TextChanged">
                                <RichTextBox.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Undo" Command="{Binding UndoCommand}" />
                                        <MenuItem Header="Redo" Command="{Binding RedoCommand}" />
                                        <Separator />
                                        <MenuItem Header="Cut" Command="{Binding CutCommand}" />
                                        <MenuItem Header="Copy" Command="{Binding CopyCommand}" />
                                        <MenuItem Header="Paste" Command="{Binding PasteCommand}" />
                                        <Separator />
                                        <MenuItem Header="Bold" Command="{Binding BoldCommand}" />
                                        <MenuItem Header="Italic" Command="{Binding ItalicCommand}" />
                                        <MenuItem Header="Strikethrough" Command="{Binding StrikethroughCommand}" />
                                        <MenuItem Header="Inline Code" Command="{Binding InlineCodeCommand}" />
                                        <Separator />
                                        <MenuItem Header="Heading 1" Command="{Binding Heading1Command}" />
                                        <MenuItem Header="Heading 2" Command="{Binding Heading2Command}" />
                                        <MenuItem Header="Heading 3" Command="{Binding Heading3Command}" />
                                        <Separator />
                                        <MenuItem Header="Code Block" Command="{Binding CodeBlockCommand}" />
                                        <MenuItem Header="Blockquote" Command="{Binding BlockquoteCommand}" />
                                        <Separator />
                                        <MenuItem Header="Unordered List" Command="{Binding UnorderedListCommand}" />
                                        <MenuItem Header="Ordered List" Command="{Binding OrderedListCommand}" />
                                        <MenuItem Header="Task List" Command="{Binding TaskListCommand}" />
                                        <Separator />
                                        <MenuItem Header="Insert Link" Command="{Binding InsertLinkCommand}" />
                                        <MenuItem Header="Insert Image" Command="{Binding InsertImageCommand}" />
                                        <MenuItem Header="Insert Table" Command="{Binding InsertTableCommand}" />
                                        <MenuItem Header="Insert Horizontal Rule" Command="{Binding InsertHorizontalRuleCommand}" />
                                        <Separator />
                                        <MenuItem Header="Select All" Command="{Binding SelectAllCommand}" />
                                        <Separator />
                                        <MenuItem Header="Copy as Markdown" Click="CopyAsMarkdown_Click" />
                                        <MenuItem Header="Copy as HTML" Click="CopyAsHtml_Click" />
                                    </ContextMenu>
                                </RichTextBox.ContextMenu>
                            </RichTextBox>
                            <editor:LineHighlightOverlay x:Name="GoToLineOverlay"
                                                     IsHitTestVisible="False"
                                                     Panel.ZIndex="30" />
                            <editor:FindHighlightOverlay x:Name="EditorFindOverlay"
                                                     IsHitTestVisible="False"
                                                     Panel.ZIndex="40" />
                            <editor:BracketHighlightOverlay x:Name="BracketOverlay"
                                                        IsHitTestVisible="False"
                                                        Panel.ZIndex="99" />
                            <editor:MinimapControl x:Name="Minimap"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Stretch"
                                               Margin="0,0,4,0"
                                               Panel.ZIndex="50" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- Visibility (Visible/Collapsed) is managed from code-behind in OnPaneVisibilityChanged -->
            <GridSplitter x:Name="SplitterColumn" Grid.Column="2" Width="6" Background="Transparent" AutomationProperties.AutomationId="SplitterColumn" />

            <!-- Animated Preview Pane Opacity -->
            <Grid x:Name="PreviewPane" Grid.Column="3">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Opacity" Value="1" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsPreviewVisible}" Value="False">
                                <!-- Disable interaction while hidden/faded out -->
                                <Setter Property="IsHitTestVisible" Value="False" />
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <!-- Fade out quickly while sliding -->
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <!-- Fade back in smoothly -->
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.3" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}" BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}" BorderThickness="0,0,0,1" Padding="8,4">
                    <TextBlock Text="PREVIEW" FontSize="12" Foreground="Gray" VerticalAlignment="Center" />
                </Border>

                <!-- Find in preview bar (its own row: WPF content cannot overlay the WebView2 HWND) -->
                <Border x:Name="PreviewFindBar" Grid.Row="1" Visibility="Collapsed" Background="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}" BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}" BorderThickness="0,0,0,1" Padding="8,4">
                    <DockPanel LastChildFill="True">
                        <Button DockPanel.Dock="Right" Style="{StaticResource PaneHeaderButton}" Content="&#xE711;" ToolTip="Close (Esc)" Click="PreviewFindClose_Click" />
                        <Button DockPanel.Dock="Right" Style="{StaticResource PaneHeaderButton}" Content="&#xE70D;" ToolTip="Next Match (Enter / F3)" Click="PreviewFindNext_Click" />
                        <Button DockPanel.Dock="Right" Style="{StaticResource PaneHeaderButton}" Content="&#xE70E;" ToolTip="Previous Match (Shift+Enter / Shift+F3)" Click="PreviewFindPrevious_Click" />
                        <TextBlock x:Name="PreviewFindStatus" DockPanel.Dock="Right" MinWidth="72" Margin="8,0,4,0" TextAlignment="Right" VerticalAlignment="Center" Foreground="Gray" />
                        <CheckBox x:Name="PreviewFindMatchCase" DockPanel.Dock="Right" Content="Aa" ToolTip="Match Case" Margin="8,0,0,0" VerticalAlignment="Center" Click="PreviewFindMatchCase_Click" />
                        <TextBox x:Name="PreviewFindBox" Background="{DynamicResource ControlBackgroundBrush}" VerticalContentAlignment="Center" Padding="2,1" TextChanged="PreviewFindBox_TextChanged" PreviewKeyDown="PreviewFindBox_PreviewKeyDown" />
                    </DockPanel>
                </Border>

                <Border Grid.Row="2" BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}" BorderThickness="1" Margin="8" CornerRadius="4">
                    <wpf:WebView2 x:Name="MarkdownPreview"
                                  NavigationStarting="MarkdownPreview_NavigationStarting" />
                </Border>
            </Grid>
        </Grid>

        <StatusBar Grid.Row="3" Height="28" Background="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}" BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}" BorderThickness="0,1,0,0">
            <StatusBarItem>
                <TextBlock x:Name="StatusCursorPosition" Text="Ln 1, Col 1" VerticalAlignment="Center" Margin="12,0" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock x:Name="StatusFileEncoding" Text="UTF-8" VerticalAlignment="Center" Margin="0,0,12,0" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock x:Name="StatusWordCount" Text="Words: 0" VerticalAlignment="Center" Margin="0,0,12,0" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock x:Name="StatusLineEnding" Text="LF" VerticalAlignment="Center" Margin="0,0,12,0" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem x:Name="StatusGitHubItem" Cursor="Hand" MouseLeftButtonUp="StatusGitHub_MouseLeftButtonUp">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE77B;" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock x:Name="StatusGitHubAccount" Text="Sign in" VerticalAlignment="Center" />
                </StackPanel>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <ComboBox x:Name="StatusZoomCombo" Width="80" Margin="0,0,12,0" VerticalAlignment="Center" Background="{DynamicResource ControlBackgroundBrush}" Foreground="{DynamicResource ControlForegroundBrush}" SelectionChanged="StatusZoomCombo_SelectionChanged">
                    <ComboBoxItem Content="50%" Tag="0.5" />
                    <ComboBoxItem Content="75%" Tag="0.75" />
                    <ComboBoxItem Content="100%" Tag="1.0" IsSelected="True" />
                    <ComboBoxItem Content="125%" Tag="1.25" />
                    <ComboBoxItem Content="150%" Tag="1.5" />
                    <ComboBoxItem Content="200%" Tag="2.0" />
                </ComboBox>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>