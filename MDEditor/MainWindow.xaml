<Window x:Class="MDEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:MDEditor.Localization"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:wpf="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:editor="clr-namespace:MDEditor.Editor"
        Title="MDEditor" Height="600" Width="1000"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource WindowForegroundBrush}"
        mc:Ignorable="d">

    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewFileCommand}" />
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenFileCommand}" />
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveFileCommand}" />
        <KeyBinding Key="S" Modifiers="Control+Shift" Command="{Binding SaveAsFileCommand}" />
        <KeyBinding Key="P" Modifiers="Control+Shift" Command="{Binding TogglePreviewCommand}" />
        <KeyBinding Key="E" Modifiers="Control+Shift" Command="{Binding ToggleOutlineCommand}" />
        <KeyBinding Key="F" Modifiers="Control" Command="{Binding FindCommand}" />
        <KeyBinding Key="H" Modifiers="Control" Command="{Binding ReplaceCommand}" />
        <KeyBinding Key="G" Modifiers="Control" Command="{Binding GoToLineCommand}" />
        <KeyBinding Key="F" Modifiers="Control+Shift" Command="{Binding FindInPreviewCommand}" />
        <KeyBinding Key="P" Modifiers="Control" Command="{Binding PrintPreviewCommand}" />
        <KeyBinding Key="F5" Command="{Binding PresentationModeCommand}" />
        <KeyBinding Key="OemPlus" Modifiers="Control" Command="{Binding ZoomInCommand}" />
        <KeyBinding Key="Add" Modifiers="Control" Command="{Binding ZoomInCommand}" />
        <KeyBinding Key="OemMinus" Modifiers="Control" Command="{Binding ZoomOutCommand}" />
        <KeyBinding Key="Subtract" Modifiers="Control" Command="{Binding ZoomOutCommand}" />
        <KeyBinding Key="D0" Modifiers="Control" Command="{Binding ResetZoomCommand}" />
        <KeyBinding Key="NumPad0" Modifiers="Control" Command="{Binding ResetZoomCommand}" />
    </Window.InputBindings>

    <Window.Resources>
        <Style x:Key="PaneHeaderButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="4,1" />
            <Setter Property="Margin" Value="2,0,0,0" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Menu x:Name="MainMenuBar" Grid.Row="0" Background="{DynamicResource ControlBackgroundBrush}">
            <MenuItem Header="{loc:Tr Menu_File}">
                <MenuItem Header="{loc:Tr Menu_New}" Command="{Binding NewFileCommand}" InputGestureText="Ctrl+N" />
                <MenuItem Header="{loc:Tr Menu_Open}" Command="{Binding OpenFileCommand}" InputGestureText="Ctrl+O" />
                <MenuItem Header="{loc:Tr Menu_OpenFromGitHub}" Command="{Binding OpenFromGitHubCommand}" />
                <MenuItem Header="{loc:Tr Menu_OpenGist}" Command="{Binding OpenGistCommand}" />
                <MenuItem Header="{loc:Tr Menu_RecentFiles}" Name="RecentFilesMenu">
                    <MenuItem Header="{loc:Tr Menu_NoRecentFiles}" IsEnabled="False" />
                </MenuItem>
                <Separator />
                <MenuItem Header="{loc:Tr Menu_Save}" Command="{Binding SaveFileCommand}" InputGestureText="Ctrl+S" />
                <MenuItem Header="{loc:Tr Menu_SaveAs}" Command="{Binding SaveAsFileCommand}" InputGestureText="Ctrl+Shift+S" />
                <MenuItem Header="{loc:Tr Menu_SaveAsGist}" Command="{Binding SaveAsGistCommand}" />
                <Separator />
                <MenuItem Header="{loc:Tr Menu_ExportHtml}" Command="{Binding ExportHtmlCommand}" />
                <MenuItem Header="{loc:Tr Menu_ExportPdf}" Command="{Binding ExportPdfCommand}" />
                <Separator />
                <MenuItem Header="{loc:Tr Menu_PrintPreview}" Command="{Binding PrintPreviewCommand}" InputGestureText="Ctrl+P" />
                <Separator />
                <MenuItem Header="{loc:Tr Menu_Exit}" Command="{Binding ExitCommand}" />
            </MenuItem>
            <MenuItem Header="{loc:Tr Menu_Edit}">
                <MenuItem Header="{loc:Tr Menu_Undo}" Command="{Binding UndoCommand}" />
                <MenuItem Header="{loc:Tr Menu_Redo}" Command="{Binding RedoCommand}" />
                <Separator />
                <MenuItem Header="{loc:Tr Menu_Cut}" Command="{Binding CutCommand}" />
                <MenuItem Header="{loc:Tr Menu_Copy}" Command="{Binding CopyCommand}" />
                <MenuItem Header="{loc:Tr Menu_Paste}" Command="{Binding PasteCommand}" />
                <Separator />
                <MenuItem Header="{loc:Tr Menu_Find}" Command="{Binding FindCommand}" InputGestureText="Ctrl+F" />
                <MenuItem Header="{loc:Tr Menu_Replace}" Command="{Binding ReplaceCommand}" InputGestureText="Ctrl+H" />
                <MenuItem Header="{loc:Tr Menu_FindInPreview}" Command="{Binding FindInPreviewCommand}" InputGestureText="Ctrl+Shift+F" />
                <MenuItem Header="{loc:Tr Menu_GoToLine}" Command="{Binding GoToLineCommand}" InputGestureText="Ctrl+G" />
                <Separator />
                <MenuItem Header="{loc:Tr Menu_SelectAll}" Command="{Binding SelectAllCommand}" />
            </MenuItem>
            <MenuItem Header="{loc:Tr Menu_View}">
                <MenuItem x:Name="PreviewMenuItem" Header="{loc:Tr Menu_ShowPreview}" Command="{Binding TogglePreviewCommand}" IsCheckable="True" InputGestureText="Ctrl+Shift+P" />
                <MenuItem x:Name="EditorMenuItem" Header="{loc:Tr Menu_ShowEditor}" Command="{Binding ToggleEditorCommand}" IsCheckable="True" />
                <MenuItem x:Name="OutlineMenuItem" Header="{loc:Tr Menu_ShowOutline}" Command="{Binding ToggleOutlineCommand}" IsCheckable="True" InputGestureText="Ctrl+Shift+E" />
                <MenuItem x:Name="LineNumbersMenuItem" Header="{loc:Tr Menu_ShowLineNumbers}" Command="{Binding ToggleLineNumbersCommand}" IsCheckable="True" />
                <MenuItem x:Name="MinimapMenuItem" Header="{loc:Tr Menu_ShowMinimap}" Click="ToggleMinimap_Click" IsCheckable="True" />
                <MenuItem x:Name="ScrollSyncMenuItem" Header="{loc:Tr Menu_ShowScrollSync}" Click="ToggleScrollSync_Click" IsCheckable="True" />
                <MenuItem Header="{loc:Tr Menu_WordWrap}" Command="{Binding ToggleWordWrapCommand}" />
                <Separator />
                <MenuItem Header="{loc:Tr Menu_ZoomIn}" Command="{Binding ZoomInCommand}" InputGestureText="Ctrl++" />
                <MenuItem Header="{loc:Tr Menu_ZoomOut}" Command="{Binding ZoomOutCommand}" InputGestureText="Ctrl+-" />
                <MenuItem Header="{loc:Tr Menu_ResetZoom}" Command="{Binding ResetZoomCommand}" InputGestureText="Ctrl+0" />
                <Separator />
                <MenuItem Header="{loc:Tr Menu_PresentationMode}" Command="{Binding PresentationModeCommand}" InputGestureText="F5" />
            </MenuItem>
            <MenuItem Header="{loc:Tr Menu_Format}">
                <MenuItem Header="{loc:Tr Menu_Heading1}" Command="{Binding Heading1Command}" InputGestureText="Ctrl+1" />
                <MenuItem Header="{loc:Tr Menu_Heading2}" Command="{Binding Heading2Command}" InputGestureText="Ctrl+2" />
                <MenuItem Header="{loc:Tr Menu_Heading3}" Command="{Binding Heading3Command}" InputGestureText="Ctrl+3" />
                <MenuItem Header="{loc:Tr Menu_Heading4}" Command="{Binding Heading4Command}" />
                <MenuItem Header="{loc:Tr Menu_Heading5}" Command="{Binding Heading5Command}" />
                <MenuItem Header="{loc:Tr Menu_Heading6}" Command="{Binding Heading6Command}" />
                <Separator />
                <MenuItem Header="{loc:Tr Menu_Bold}" Command="{Binding BoldCommand}" InputGestureText="Ctrl+B" />
                <MenuItem Header="{loc:Tr Menu_Italic}" Command="{Binding ItalicCommand}" InputGestureText="Ctrl+I" />
                <MenuItem Header="{loc:Tr Menu_Strikethrough}" Command="{Binding StrikethroughCommand}" InputGestureText="Ctrl+Shift+X" />
                <MenuItem Header="{loc:Tr Menu_InlineCode}" Command="{Binding InlineCodeCommand}" InputGestureText="Ctrl+`" />
                <Separator />
                <MenuItem Header="{loc:Tr Menu_CodeBlock}" Command="{Binding CodeBlockCommand}" InputGestureText="Ctrl+Shift+C" />
                <MenuItem Header="{loc:Tr Menu_Blockquote}" Command="{Binding BlockquoteCommand}" InputGestureText="Ctrl+Q" />
                <Separator />
                <MenuItem Header="{loc:Tr Menu_UnorderedList}" Command="{Binding UnorderedListCommand}" InputGestureText="Ctrl+Shift+L" />
                <MenuItem Header="{loc:Tr Menu_OrderedList}" Command="{Binding OrderedListCommand}" InputGestureText="Ctrl+Shift+O" />
                <MenuItem Header="{loc:Tr Menu_TaskList}" Command="{Binding TaskListCommand}" InputGestureText="Ctrl+Shift+T" />
                <Separator />
                <MenuItem Header="{loc:Tr Menu_Link}" Command="{Binding InsertLinkCommand}" InputGestureText="Ctrl+K" />
                <MenuItem Header="{loc:Tr Menu_Image}" Command="{Binding InsertImageCommand}" InputGestureText="Ctrl+Shift+I" />
                <MenuItem Header="{loc:Tr Menu_Table}" Command="{Binding InsertTableCommand}" />
                <MenuItem Header="{loc:Tr Menu_HorizontalRule}" Command="{Binding InsertHorizontalRuleCommand}" />
                <MenuItem Header="{loc:Tr Menu_MathBlock}" Command="{Binding MathBlockCommand}" />
            </MenuItem>
            <MenuItem Header="{loc:Tr Menu_Tools}">
                <MenuItem x:Name="SmartTypographyMenuItem"
                          Header="{loc:Tr Menu_SmartTypography}"
                          IsCheckable="True"
                          IsChecked="True"
                          Click="SmartTypography_Click" />
                <Separator />
                <MenuItem Header="{loc:Tr Menu_GitHubAccounts}" Command="{Binding GitHubAccountsCommand}" />
                <MenuItem Header="{loc:Tr Menu_CommitToGitHub}" Command="{Binding GitHubSyncCommand}"
                          Visibility="{Binding IsGitHubDocument, Converter={StaticResource BoolToVisibility}}" />
                <MenuItem Header="{loc:Tr Menu_FileHistory}" Command="{Binding GitHubHistoryCommand}"
                          Visibility="{Binding IsGitHubDocument, Converter={StaticResource BoolToVisibility}}" />
                <MenuItem Header="{loc:Tr Menu_ViewGist}" Command="{Binding ViewGistCommand}"
                          Visibility="{Binding IsGistDocument, Converter={StaticResource BoolToVisibility}}" />
                <MenuItem Header="{loc:Tr Menu_GistHistory}" Command="{Binding GistHistoryCommand}"
                          Visibility="{Binding IsGistDocument, Converter={StaticResource BoolToVisibility}}" />
                <MenuItem Header="{loc:Tr Menu_Settings}" Command="{Binding SettingsCommand}" />
            </MenuItem>
            <MenuItem Header="{loc:Tr Menu_Help}">
                <MenuItem Header="{loc:Tr Menu_MarkdownGuide}" Command="{Binding MarkdownGuideCommand}" />
                <Separator />
                <MenuItem Header="{loc:Tr Menu_About}" Command="{Binding AboutCommand}" />
            </MenuItem>
        </Menu>

        <ToolBar x:Name="MainCommandBar" Grid.Row="1" Background="{DynamicResource ControlBackgroundBrush}">
            <Button Command="{Binding NewFileCommand}" AutomationProperties.Name="{loc:Tr Tip_New}" ToolTip="{loc:Tr Tip_New}">
                <Button.Content>
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8A5;" />
                </Button.Content>
            </Button>
            <Button Command="{Binding OpenFileCommand}" AutomationProperties.Name="{loc:Tr Tip_Open}" ToolTip="{loc:Tr Tip_Open}">
                <Button.Content>
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8E5;" />
                </Button.Content>
            </Button>
            <Button Command="{Binding SaveFileCommand}" AutomationProperties.Name="{loc:Tr Tip_Save}" ToolTip="{loc:Tr Tip_Save}">
                <Button.Content>
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE74E;" />
                </Button.Content>
            </Button>
            <Separator />
            <Button Command="{Binding UndoCommand}" AutomationProperties.Name="{loc:Tr Tip_Undo}" ToolTip="{loc:Tr Tip_Undo}">
                <Button.Content>
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE7A7;" />
                </Button.Content>
            </Button>
            <Button Command="{Binding RedoCommand}" AutomationProperties.Name="{loc:Tr Tip_Redo}" ToolTip="{loc:Tr Tip_Redo}">
                <Button.Content>
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE7A6;" />
                </Button.Content>
            </Button>
            <Separator />
            <Button Command="{Binding BoldCommand}" AutomationProperties.Name="{loc:Tr Tip_Bold}" ToolTip="{loc:Tr Tip_Bold}">
                <Button.Content>
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8DD;" />
                </Button.Content>
            </Button>
            <Button Command="{Binding ItalicCommand}" AutomationProperties.Name="{loc:Tr Tip_Italic}" ToolTip="{loc:Tr Tip_Italic}">
                <Button.Content>
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8DB;" />
                </Button.Content>
            </Button>
            <Button Command="{Binding StrikethroughCommand}" AutomationProperties.Name="{loc:Tr Tip_Strikethrough}" ToolTip="{loc:Tr Tip_Strikethrough}">
                <Button.Content>
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xEDE0;" />
                </Button.Content>
            </Button>
            <Button Command="{Binding InlineCodeCommand}" AutomationProperties.Name="{loc:Tr Tip_InlineCode}" ToolTip="{loc:Tr Tip_InlineCode}">
                <Button.Content>
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE943;" />
                </Button.Content>
            </Button>
            <Separator />
            <Button Command="{Binding CodeBlockCommand}" AutomationProperties.Name="{loc:Tr Tip_CodeBlock}" ToolTip="{loc:Tr Tip_CodeBlock}">
                <Button.Content>
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE943;" VerticalAlignment="Bottom" />
                </Button.Content>
            </Button>
            <Button Command="{Binding BlockquoteCommand}" AutomationProperties.Name="{loc:Tr Tip_Blockquote}" ToolTip="{loc:Tr Tip_Blockquote}">
                <Button.Content>
                    <TextBlock Text="&gt;" />
                </Button.Content>
            </Button>
            <Separator />
            <Button Command="{Binding Heading1Command}" AutomationProperties.Name="{loc:Tr Tip_Heading1}" ToolTip="{loc:Tr Tip_Heading1}">
                <Button.Content>
                    <TextBlock Text="H1" />
                </Button.Content>
            </Button>
            <Button Command="{Binding Heading2Command}" AutomationProperties.Name="{loc:Tr Tip_Heading2}" ToolTip="{loc:Tr Tip_Heading2}">
                <Button.Content>
                    <TextBlock Text="H2" />
                </Button.Content>
            </Button>
            <Button Command="{Binding Heading3Command}" AutomationProperties.Name="{loc:Tr Tip_Heading3}" ToolTip="{loc:Tr Tip_Heading3}">
                <Button.Content>
                    <TextBlock Text="H3" />
                </Button.Content>
            </Button>
            <Separator />
            <Button Command="{Binding UnorderedListCommand}" AutomationProperties.Name="{loc:Tr Tip_UnorderedList}" ToolTip="{loc:Tr Tip_UnorderedList}">
                <Button.Content>
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8FD;" />
                </Button.Content>
            </Button>
            <Button Command="{Binding OrderedListCommand}" AutomationProperties.Name="{loc:Tr Tip_OrderedList}" ToolTip="{loc:Tr Tip_OrderedList}">
                <Button.Content>
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8FD;" />
                </Button.Content>
            </Button>
            <Button Command="{Binding TaskListCommand}" AutomationProperties.Name="{loc:Tr Tip_TaskList}" ToolTip="{loc:Tr Tip_TaskList}">
                <Button.Content>
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE73E;" />
                </Button.Content>
            </Button>
            <Separator />
            <Button Command="{Binding InsertLinkCommand}" AutomationProperties.Name="{loc:Tr Tip_InsertLink}" ToolTip="{loc:Tr Tip_InsertLink}">
                <Button.Content>
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE71B;" />
                </Button.Content>
            </Button>
            <Button Command="{Binding InsertImageCommand}" AutomationProperties.Name="{loc:Tr Tip_InsertImage}" ToolTip="{loc:Tr Tip_InsertImage}">
                <Button.Content>
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8B9;" />
                </Button.Content>
            </Button>
            <Button Command="{Binding InsertTableCommand}" AutomationProperties.Name="{loc:Tr Menu_InsertTable}" ToolTip="{loc:Tr Menu_InsertTable}">
                <Button.Content>
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8F1;" />
                </Button.Content>
            </Button>
            <Separator />
            <Button Command="{Binding TogglePreviewCommand}" AutomationProperties.Name="{loc:Tr Tip_TogglePreview}" ToolTip="{loc:Tr Tip_TogglePreview}">
                <Button.Content>
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8A1;" />
                </Button.Content>
            </Button>
            <Button Command="{Binding ToggleEditorCommand}" AutomationProperties.Name="{loc:Tr Tip_ToggleEditor}" ToolTip="{loc:Tr Tip_ToggleEditor}">
                <Button.Content>
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE70F;" />
                </Button.Content>
            </Button>
            <Button Command="{Binding ToggleOutlineCommand}" AutomationProperties.Name="{loc:Tr Tip_ToggleOutline}" ToolTip="{loc:Tr Tip_ToggleOutline}">
                <Button.Content>
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE700;" />
                </Button.Content>
            </Button>
            <Button Command="{Binding FindInPreviewCommand}" AutomationProperties.Name="{loc:Tr Tip_FindInPreview}" ToolTip="{loc:Tr Tip_FindInPreview}">
                <Button.Content>
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE721;" />
                </Button.Content>
            </Button>
            <Separator />
            <Button Command="{Binding PrintPreviewCommand}" AutomationProperties.Name="{loc:Tr Tip_PrintPreview}" ToolTip="{loc:Tr Tip_PrintPreview}">
                <Button.Content>
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE749;" />
                </Button.Content>
            </Button>
            <Button Command="{Binding PresentationModeCommand}" AutomationProperties.Name="{loc:Tr Tip_PresentationMode}" ToolTip="{loc:Tr Tip_PresentationMode}">
                <Button.Content>
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE740;" />
                </Button.Content>
            </Button>
        </ToolBar>

        <Grid x:Name="MainContentGrid" Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="OutlineColumn" Width="Auto" />
                <!--
                    Editor/Preview column widths are managed entirely from code-behind
                    (MainWindow.OnPaneVisibilityChanged) rather than XAML DataTriggers.
                    ColumnDefinition does not reliably participate in DataContext
                    inheritance, so binding-driven triggers here silently failed to
                    reallocate width to the sibling column when one pane was hidden.
                -->
                <ColumnDefinition x:Name="EditorColumn" Width="*" MinWidth="300" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="PreviewColumn" Width="*" MinWidth="300" />
            </Grid.ColumnDefinitions>

            <!-- Outline / TOC panel (collapsible, resizable via the thumb on its right edge) -->
            <Grid x:Name="OutlinePane" Grid.Column="0" Width="240" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}" BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}" BorderThickness="0,0,0,1" Padding="8,4">
                    <DockPanel LastChildFill="False">
                        <TextBlock DockPanel.Dock="Left" Text="{loc:Tr Pane_Outline}" FontSize="12" Foreground="Gray" VerticalAlignment="Center" />
                        <Button DockPanel.Dock="Right" Style="{StaticResource PaneHeaderButton}" Content="&#xE711;" AutomationProperties.Name="{loc:Tr Tip_CloseOutline}" ToolTip="{loc:Tr Tip_CloseOutline}" Command="{Binding ToggleOutlineCommand}" />
                        <Button DockPanel.Dock="Right" Style="{StaticResource PaneHeaderButton}" Content="&#xE70E;" AutomationProperties.Name="{loc:Tr Tip_CollapseAll}" ToolTip="{loc:Tr Tip_CollapseAll}" Click="OutlineCollapseAll_Click" />
                        <Button DockPanel.Dock="Right" Style="{StaticResource PaneHeaderButton}" Content="&#xE70D;" AutomationProperties.Name="{loc:Tr Tip_ExpandAll}" ToolTip="{loc:Tr Tip_ExpandAll}" Click="OutlineExpandAll_Click" />
                    </DockPanel>
                </Border>

                <Border Grid.Row="1" BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}" BorderThickness="1" Margin="8,8,4,8" CornerRadius="4">
                    <Grid>
                        <TreeView x:Name="OutlineTree" AutomationProperties.Name="{loc:Tr Pane_Outline}"
                                  Background="{DynamicResource ControlBackgroundBrush}"
                                  BorderThickness="0"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  PreviewMouseLeftButtonUp="OutlineTree_PreviewMouseLeftButtonUp"
                                  KeyDown="OutlineTree_KeyDown">
                            <TreeView.ItemContainerStyle>
                                <Style TargetType="TreeViewItem">
                                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                    <Setter Property="ToolTip" Value="{Binding Title}" />
                                </Style>
                            </TreeView.ItemContainerStyle>
                            <TreeView.ItemTemplate>
                                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" Padding="2,1">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                        <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HotTrackBrushKey}}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </HierarchicalDataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>
                        <TextBlock x:Name="OutlineEmptyText"
                                   Text="{loc:Tr Outline_Empty}"
                                   Foreground="Gray"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   Margin="12"
                                   VerticalAlignment="Top"
                                   IsHitTestVisible="False" />
                    </Grid>
                </Border>

                <Thumb x:Name="OutlineResizeThumb"
                       Grid.RowSpan="2"
                       Width="5"
                       HorizontalAlignment="Right"
                       Cursor="SizeWE"
                       DragDelta="OutlineResizeThumb_DragDelta"
                       DragCompleted="OutlineResizeThumb_DragCompleted">
                    <Thumb.Template>
                        <ControlTemplate TargetType="Thumb">
                            <Border Background="Transparent" />
                        </ControlTemplate>
                    </Thumb.Template>
                </Thumb>
            </Grid>

            <Grid x:Name="EditorPane" Grid.Column="1">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Opacity" Value="1" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsEditorVisible}" Value="False">
                                <!-- Disable interaction while hidden/faded out -->
                                <Setter Property="IsHitTestVisible" Value="False" />
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.3" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}" BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}" BorderThickness="0,0,0,1" Padding="8,4">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{loc:Tr Pane_Editor}" FontSize="12" Foreground="Gray" VerticalAlignment="Center" />
                        <TextBlock x:Name="EditorFileName" Text="Untitled.md" VerticalAlignment="Center" Margin="8,0,0,0" />
                        <TextBlock x:Name="EditorDirtyIndicator" Text="●" FontSize="12" Foreground="Red" VerticalAlignment="Center" Margin="4,0,0,0" Visibility="Collapsed" />
                    </StackPanel>
                </Border>

                <!-- Find / replace bar for the editor (mirrors the find in preview bar) -->
                <Border x:Name="EditorFindBar" Grid.Row="1" Visibility="Collapsed" Background="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}" BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}" BorderThickness="0,0,0,1" Padding="8,4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Button x:Name="EditorFindToggleReplace" Grid.Row="0" Grid.Column="0" Style="{StaticResource PaneHeaderButton}" Margin="0,0,4,0" Content="&#xE76C;" AutomationProperties.Name="{loc:Tr Tip_ToggleReplace}" ToolTip="{loc:Tr Tip_ToggleReplace}" Click="EditorFindToggleReplace_Click" />
                        <TextBox x:Name="EditorFindBox" Grid.Row="0" Grid.Column="1" Background="{DynamicResource ControlBackgroundBrush}" VerticalContentAlignment="Center" Padding="2,1" AutomationProperties.Name="{loc:Tr Menu_Find}" ToolTip="{loc:Tr Menu_Find}" TextChanged="EditorFindBox_TextChanged" PreviewKeyDown="EditorFindBox_PreviewKeyDown" />
                        <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal">
                            <CheckBox x:Name="EditorFindMatchCase" Content="Aa" AutomationProperties.Name="{loc:Tr Tip_MatchCase}" ToolTip="{loc:Tr Tip_MatchCase}" Margin="8,0,0,0" VerticalAlignment="Center" Click="EditorFindMatchCase_Click" />
                            <TextBlock x:Name="EditorFindStatus" MinWidth="72" Margin="8,0,4,0" TextAlignment="Right" VerticalAlignment="Center" Foreground="Gray" />
                            <Button Style="{StaticResource PaneHeaderButton}" Content="&#xE70E;" AutomationProperties.Name="{loc:Tr Tip_PreviousMatch}" ToolTip="{loc:Tr Tip_PreviousMatch}" Click="EditorFindPrevious_Click" />
                            <Button Style="{StaticResource PaneHeaderButton}" Content="&#xE70D;" AutomationProperties.Name="{loc:Tr Tip_NextMatch}" ToolTip="{loc:Tr Tip_NextMatch}" Click="EditorFindNext_Click" />
                            <Button Style="{StaticResource PaneHeaderButton}" Content="&#xE711;" AutomationProperties.Name="{loc:Tr Tip_CloseEsc}" ToolTip="{loc:Tr Tip_CloseEsc}" Click="EditorFindClose_Click" />
                        </StackPanel>

                        <TextBox x:Name="EditorReplaceBox" Grid.Row="1" Grid.Column="1" Background="{DynamicResource ControlBackgroundBrush}" Margin="0,4,0,0" Visibility="Collapsed" VerticalContentAlignment="Center" Padding="2,1" AutomationProperties.Name="{loc:Tr Menu_Replace}" ToolTip="{loc:Tr Menu_Replace}" PreviewKeyDown="EditorReplaceBox_PreviewKeyDown" />
                        <StackPanel x:Name="EditorReplaceActions" Grid.Row="1" Grid.Column="2" Orientation="Horizontal" Margin="8,4,0,0" Visibility="Collapsed">
                            <Button Content="{loc:Tr Menu_Replace}" Padding="8,0" Margin="0,0,4,0" AutomationProperties.Name="{loc:Tr Tip_ReplaceEnter}" ToolTip="{loc:Tr Tip_ReplaceEnter}" Click="EditorReplace_Click" />
                            <Button Content="{loc:Tr Find_ReplaceAll}" Padding="8,0" AutomationProperties.Name="{loc:Tr Tip_ReplaceAll}" ToolTip="{loc:Tr Tip_ReplaceAll}" Click="EditorReplaceAll_Click" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Go to line bar (same slot as the find bar; only one is shown at a time) -->
                <Border x:Name="GoToLineBar" Grid.Row="1" Visibility="Collapsed" Background="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}" BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}" BorderThickness="0,0,0,1" Padding="8,4">
                    <DockPanel LastChildFill="True">
                        <Button DockPanel.Dock="Right" Style="{StaticResource PaneHeaderButton}" Content="&#xE711;" AutomationProperties.Name="{loc:Tr Tip_CloseEsc}" ToolTip="{loc:Tr Tip_CloseEsc}" Click="GoToLineClose_Click" />
                        <TextBlock x:Name="GoToLineStatus" DockPanel.Dock="Right" MinWidth="72" Margin="8,0,4,0" TextAlignment="Right" VerticalAlignment="Center" Foreground="Gray" />
                        <TextBlock DockPanel.Dock="Left" Text="{loc:Tr GoTo_Label}" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox x:Name="GoToLineBox" Background="{DynamicResource ControlBackgroundBrush}" VerticalContentAlignment="Center" Padding="2,1" AutomationProperties.Name="{loc:Tr Tip_GoToLineBox}" ToolTip="{loc:Tr Tip_GoToLineBox}" TextChanged="GoToLineBox_TextChanged" PreviewKeyDown="GoToLineBox_PreviewKeyDown" LostKeyboardFocus="GoToLineBox_LostKeyboardFocus" />
                    </DockPanel>
                </Border>

                <Border Grid.Row="2" Background="{DynamicResource EditorBackgroundBrush}" BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}" BorderThickness="1" Margin="8" CornerRadius="4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <editor:LineNumberGutter x:Name="LineNumberGutter"
                                                 Grid.Column="0"
                                                 Visibility="Collapsed" />
                        <Grid Grid.Column="1">
                            <RichTextBox x:Name="MarkdownEditor" AutomationProperties.Name="{loc:Tr Pane_Editor}"
                                     Background="{DynamicResource EditorBackgroundBrush}"
                                     Foreground="{DynamicResource EditorForegroundBrush}"
                                     CaretBrush="{DynamicResource EditorForegroundBrush}"
                                     BorderThickness="0"
                                     FontFamily="Cascadia Code, Consolas, monospace"
                                     FontSize="14"
                                     AcceptsReturn="True"
                                     Padding="4,0,4,0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     TextChanged="MarkdownEditor_TextChanged">
                                <!-- Instance bindings take precedence over RichTextBox's built-in class bindings,
                                     so Ctrl+B/I/1/2/Shift+L etc. insert Markdown instead of applying invisible
                                     rich-text formatting. -->
                                <RichTextBox.InputBindings>
                                    <KeyBinding Key="B" Modifiers="Control" Command="{Binding BoldCommand}" />
                                    <KeyBinding Key="I" Modifiers="Control" Command="{Binding ItalicCommand}" />
                                    <KeyBinding Key="X" Modifiers="Control+Shift" Command="{Binding StrikethroughCommand}" />
                                    <KeyBinding Key="Oem3" Modifiers="Control" Command="{Binding InlineCodeCommand}" />
                                    <KeyBinding Key="C" Modifiers="Control+Shift" Command="{Binding CodeBlockCommand}" />
                                    <KeyBinding Key="Q" Modifiers="Control" Command="{Binding BlockquoteCommand}" />
                                    <KeyBinding Key="D1" Modifiers="Control" Command="{Binding Heading1Command}" />
                                    <KeyBinding Key="D2" Modifiers="Control" Command="{Binding Heading2Command}" />
                                    <KeyBinding Key="D3" Modifiers="Control" Command="{Binding Heading3Command}" />
                                    <KeyBinding Key="L" Modifiers="Control+Shift" Command="{Binding UnorderedListCommand}" />
                                    <KeyBinding Key="O" Modifiers="Control+Shift" Command="{Binding OrderedListCommand}" />
                                    <KeyBinding Key="T" Modifiers="Control+Shift" Command="{Binding TaskListCommand}" />
                                    <KeyBinding Key="K" Modifiers="Control" Command="{Binding InsertLinkCommand}" />
                                    <KeyBinding Key="I" Modifiers="Control+Shift" Command="{Binding InsertImageCommand}" />
                                </RichTextBox.InputBindings>
                                <RichTextBox.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="{loc:Tr Menu_Undo}" Command="{Binding UndoCommand}" />
                                        <MenuItem Header="{loc:Tr Menu_Redo}" Command="{Binding RedoCommand}" />
                                        <Separator />
                                        <MenuItem Header="{loc:Tr Menu_Cut}" Command="{Binding CutCommand}" />
                                        <MenuItem Header="{loc:Tr Menu_Copy}" Command="{Binding CopyCommand}" />
                                        <MenuItem Header="{loc:Tr Menu_Paste}" Command="{Binding PasteCommand}" />
                                        <Separator />
                                        <MenuItem Header="{loc:Tr Menu_Bold}" Command="{Binding BoldCommand}" />
                                        <MenuItem Header="{loc:Tr Menu_Italic}" Command="{Binding ItalicCommand}" />
                                        <MenuItem Header="{loc:Tr Menu_Strikethrough}" Command="{Binding StrikethroughCommand}" />
                                        <MenuItem Header="{loc:Tr Menu_InlineCode}" Command="{Binding InlineCodeCommand}" />
                                        <Separator />
                                        <MenuItem Header="{loc:Tr Menu_Heading1}" Command="{Binding Heading1Command}" />
                                        <MenuItem Header="{loc:Tr Menu_Heading2}" Command="{Binding Heading2Command}" />
                                        <MenuItem Header="{loc:Tr Menu_Heading3}" Command="{Binding Heading3Command}" />
                                        <Separator />
                                        <MenuItem Header="{loc:Tr Menu_CodeBlock}" Command="{Binding CodeBlockCommand}" />
                                        <MenuItem Header="{loc:Tr Menu_Blockquote}" Command="{Binding BlockquoteCommand}" />
                                        <Separator />
                                        <MenuItem Header="{loc:Tr Menu_UnorderedList}" Command="{Binding UnorderedListCommand}" />
                                        <MenuItem Header="{loc:Tr Menu_OrderedList}" Command="{Binding OrderedListCommand}" />
                                        <MenuItem Header="{loc:Tr Menu_TaskList}" Command="{Binding TaskListCommand}" />
                                        <Separator />
                                        <MenuItem Header="{loc:Tr Menu_InsertLink}" Command="{Binding InsertLinkCommand}" />
                                        <MenuItem Header="{loc:Tr Menu_InsertImage}" Command="{Binding InsertImageCommand}" />
                                        <MenuItem Header="{loc:Tr Menu_InsertTable}" Command="{Binding InsertTableCommand}" />
                                        <MenuItem Header="{loc:Tr Menu_InsertHorizontalRule}" Command="{Binding InsertHorizontalRuleCommand}" />
                                        <Separator />
                                        <MenuItem Header="{loc:Tr Menu_SelectAll}" Command="{Binding SelectAllCommand}" />
                                        <Separator />
                                        <MenuItem Header="{loc:Tr Menu_CopyAsMarkdown}" Click="CopyAsMarkdown_Click" />
                                        <MenuItem Header="{loc:Tr Menu_CopyAsHtml}" Click="CopyAsHtml_Click" />
                                    </ContextMenu>
                                </RichTextBox.ContextMenu>
                            </RichTextBox>
                            <editor:LineHighlightOverlay x:Name="GoToLineOverlay"
                                                     IsHitTestVisible="False"
                                                     Panel.ZIndex="30" />
                            <editor:FindHighlightOverlay x:Name="EditorFindOverlay"
                                                     IsHitTestVisible="False"
                                                     Panel.ZIndex="40" />
                            <editor:BracketHighlightOverlay x:Name="BracketOverlay"
                                                        IsHitTestVisible="False"
                                                        Panel.ZIndex="99" />
                            <editor:MinimapControl x:Name="Minimap"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Stretch"
                                               Margin="0,0,4,0"
                                               Panel.ZIndex="50" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- Visibility (Visible/Collapsed) is managed from code-behind in OnPaneVisibilityChanged -->
            <GridSplitter x:Name="SplitterColumn" Grid.Column="2" Width="6" Background="Transparent" AutomationProperties.AutomationId="SplitterColumn" />

            <!-- Animated Preview Pane Opacity -->
            <Grid x:Name="PreviewPane" Grid.Column="3">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Opacity" Value="1" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsPreviewVisible}" Value="False">
                                <!-- Disable interaction while hidden/faded out -->
                                <Setter Property="IsHitTestVisible" Value="False" />
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <!-- Fade out quickly while sliding -->
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <!-- Fade back in smoothly -->
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.3" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}" BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}" BorderThickness="0,0,0,1" Padding="8,4">
                    <TextBlock Text="{loc:Tr Pane_Preview}" FontSize="12" Foreground="Gray" VerticalAlignment="Center" />
                </Border>

                <!-- Find in preview bar (its own row: WPF content cannot overlay the WebView2 HWND) -->
                <Border x:Name="PreviewFindBar" Grid.Row="1" Visibility="Collapsed" Background="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}" BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}" BorderThickness="0,0,0,1" Padding="8,4">
                    <DockPanel LastChildFill="True">
                        <Button DockPanel.Dock="Right" Style="{StaticResource PaneHeaderButton}" Content="&#xE711;" AutomationProperties.Name="{loc:Tr Tip_CloseEsc}" ToolTip="{loc:Tr Tip_CloseEsc}" Click="PreviewFindClose_Click" />
                        <Button DockPanel.Dock="Right" Style="{StaticResource PaneHeaderButton}" Content="&#xE70D;" AutomationProperties.Name="{loc:Tr Tip_NextMatch}" ToolTip="{loc:Tr Tip_NextMatch}" Click="PreviewFindNext_Click" />
                        <Button DockPanel.Dock="Right" Style="{StaticResource PaneHeaderButton}" Content="&#xE70E;" AutomationProperties.Name="{loc:Tr Tip_PreviousMatch}" ToolTip="{loc:Tr Tip_PreviousMatch}" Click="PreviewFindPrevious_Click" />
                        <TextBlock x:Name="PreviewFindStatus" DockPanel.Dock="Right" MinWidth="72" Margin="8,0,4,0" TextAlignment="Right" VerticalAlignment="Center" Foreground="Gray" />
                        <CheckBox x:Name="PreviewFindMatchCase" DockPanel.Dock="Right" Content="Aa" AutomationProperties.Name="{loc:Tr Tip_MatchCase}" ToolTip="{loc:Tr Tip_MatchCase}" Margin="8,0,0,0" VerticalAlignment="Center" Click="PreviewFindMatchCase_Click" />
                        <TextBox x:Name="PreviewFindBox" Background="{DynamicResource ControlBackgroundBrush}" VerticalContentAlignment="Center" Padding="2,1" TextChanged="PreviewFindBox_TextChanged" PreviewKeyDown="PreviewFindBox_PreviewKeyDown" />
                    </DockPanel>
                </Border>

                <Border Grid.Row="2" BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}" BorderThickness="1" Margin="8" CornerRadius="4">
                    <wpf:WebView2 x:Name="MarkdownPreview" AutomationProperties.Name="{loc:Tr Pane_Preview}"
                                  NavigationStarting="MarkdownPreview_NavigationStarting" />
                </Border>
            </Grid>
        </Grid>

        <StatusBar Grid.Row="3" Height="28" Background="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}" BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}" BorderThickness="0,1,0,0">
            <StatusBarItem>
                <TextBlock x:Name="StatusCursorPosition" Text="{loc:Tr Status_InitialPosition}" VerticalAlignment="Center" Margin="12,0" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock x:Name="StatusFileEncoding" Text="UTF-8" VerticalAlignment="Center" Margin="0,0,12,0" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock x:Name="StatusWordCount" Text="{loc:Tr Status_InitialWords}" VerticalAlignment="Center" Margin="0,0,12,0" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock x:Name="StatusLineEnding" Text="LF" VerticalAlignment="Center" Margin="0,0,12,0" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem x:Name="StatusGitHubItem" Cursor="Hand" MouseLeftButtonUp="StatusGitHub_MouseLeftButtonUp">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE77B;" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock x:Name="StatusGitHubAccount" Text="{loc:Tr Status_SignIn}" VerticalAlignment="Center" />
                </StackPanel>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <ComboBox x:Name="StatusZoomCombo" Width="80" Margin="0,0,12,0" VerticalAlignment="Center" Background="{DynamicResource ControlBackgroundBrush}" Foreground="{DynamicResource ControlForegroundBrush}" SelectionChanged="StatusZoomCombo_SelectionChanged">
                    <ComboBoxItem Content="50%" Tag="0.5" />
                    <ComboBoxItem Content="75%" Tag="0.75" />
                    <ComboBoxItem Content="100%" Tag="1.0" IsSelected="True" />
                    <ComboBoxItem Content="125%" Tag="1.25" />
                    <ComboBoxItem Content="150%" Tag="1.5" />
                    <ComboBoxItem Content="200%" Tag="2.0" />
                </ComboBox>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>