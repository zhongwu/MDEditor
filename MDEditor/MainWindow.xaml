<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="MDEditor.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:MDEditor"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="MDEditor"
    mc:Ignorable="d">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />  <!-- Title Bar -->
            <RowDefinition Height="Auto" />  <!-- Menu Bar -->
            <RowDefinition Height="Auto" />  <!-- Toolbar -->
            <RowDefinition Height="*" />     <!-- Editor/Preview panes -->
            <RowDefinition Height="Auto" />  <!-- Status Bar -->
        </Grid.RowDefinitions>

        <!-- Custom Title Bar -->
        <TitleBar x:Name="AppTitleBar" Title="MDEditor" Grid.Row="0" />

        <!-- Menu Bar -->
        <MenuBar x:Name="MainMenuBar" Grid.Row="1" HorizontalAlignment="Stretch">
            <MenuBarItem Title="File">
                <MenuFlyoutItem Text="New" Command="{x:Bind ViewModel.NewFileCommand}" />
                <MenuFlyoutItem Text="Open..." Command="{x:Bind ViewModel.OpenFileCommand}" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Save" Command="{x:Bind ViewModel.SaveFileCommand}" />
                <MenuFlyoutItem Text="Save As..." Command="{x:Bind ViewModel.SaveAsFileCommand}" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Export HTML" Command="{x:Bind ViewModel.ExportHtmlCommand}" />
                <MenuFlyoutItem Text="Export PDF" Command="{x:Bind ViewModel.ExportPdfCommand}" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Exit" Command="{x:Bind ViewModel.ExitCommand}" />
            </MenuBarItem>

            <MenuBarItem Title="Edit">
                <MenuFlyoutItem Text="Undo" Command="{x:Bind ViewModel.UndoCommand}" />
                <MenuFlyoutItem Text="Redo" Command="{x:Bind ViewModel.RedoCommand}" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Cut" Command="{x:Bind ViewModel.CutCommand}" />
                <MenuFlyoutItem Text="Copy" Command="{x:Bind ViewModel.CopyCommand}" />
                <MenuFlyoutItem Text="Paste" Command="{x:Bind ViewModel.PasteCommand}" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Find" Command="{x:Bind ViewModel.FindCommand}" />
                <MenuFlyoutItem Text="Replace" Command="{x:Bind ViewModel.ReplaceCommand}" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Select All" Command="{x:Bind ViewModel.SelectAllCommand}" />
            </MenuBarItem>

            <MenuBarItem Title="View">
                <MenuFlyoutItem Text="Toggle Preview" Command="{x:Bind ViewModel.TogglePreviewCommand}" />
                <MenuFlyoutItem Text="Toggle Line Numbers" Command="{x:Bind ViewModel.ToggleLineNumbersCommand}" />
                <MenuFlyoutItem Text="Word Wrap" Command="{x:Bind ViewModel.ToggleWordWrapCommand}" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Zoom In" Command="{x:Bind ViewModel.ZoomInCommand}" />
                <MenuFlyoutItem Text="Zoom Out" Command="{x:Bind ViewModel.ZoomOutCommand}" />
                <MenuFlyoutItem Text="Reset Zoom" Command="{x:Bind ViewModel.ResetZoomCommand}" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Theme" Command="{x:Bind ViewModel.CycleThemeCommand}" />
            </MenuBarItem>

            <MenuBarItem Title="Format">
                <MenuFlyoutItem Text="Heading 1" Command="{x:Bind ViewModel.Heading1Command}" />
                <MenuFlyoutItem Text="Heading 2" Command="{x:Bind ViewModel.Heading2Command}" />
                <MenuFlyoutItem Text="Heading 3" Command="{x:Bind ViewModel.Heading3Command}" />
                <MenuFlyoutItem Text="Heading 4" Command="{x:Bind ViewModel.Heading4Command}" />
                <MenuFlyoutItem Text="Heading 5" Command="{x:Bind ViewModel.Heading5Command}" />
                <MenuFlyoutItem Text="Heading 6" Command="{x:Bind ViewModel.Heading6Command}" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Bold" Command="{x:Bind ViewModel.BoldCommand}" />
                <MenuFlyoutItem Text="Italic" Command="{x:Bind ViewModel.ItalicCommand}" />
                <MenuFlyoutItem Text="Strikethrough" Command="{x:Bind ViewModel.StrikethroughCommand}" />
                <MenuFlyoutItem Text="Inline Code" Command="{x:Bind ViewModel.InlineCodeCommand}" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Code Block" Command="{x:Bind ViewModel.CodeBlockCommand}" />
                <MenuFlyoutItem Text="Blockquote" Command="{x:Bind ViewModel.BlockquoteCommand}" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Unordered List" Command="{x:Bind ViewModel.UnorderedListCommand}" />
                <MenuFlyoutItem Text="Ordered List" Command="{x:Bind ViewModel.OrderedListCommand}" />
                <MenuFlyoutItem Text="Task List" Command="{x:Bind ViewModel.TaskListCommand}" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Link" Command="{x:Bind ViewModel.InsertLinkCommand}" />
                <MenuFlyoutItem Text="Image" Command="{x:Bind ViewModel.InsertImageCommand}" />
                <MenuFlyoutItem Text="Table" Command="{x:Bind ViewModel.InsertTableCommand}" />
                <MenuFlyoutItem Text="Horizontal Rule" Command="{x:Bind ViewModel.InsertHorizontalRuleCommand}" />
            </MenuBarItem>

            <MenuBarItem Title="Tools">
                <MenuFlyoutItem Text="GitHub Sync" Command="{x:Bind ViewModel.GitHubSyncCommand}" />
                <MenuFlyoutItem Text="Settings" Command="{x:Bind ViewModel.SettingsCommand}" />
            </MenuBarItem>

            <MenuBarItem Title="Help">
                <MenuFlyoutItem Text="Keyboard Shortcuts" Command="{x:Bind ViewModel.KeyboardShortcutsCommand}" />
                <MenuFlyoutItem Text="Markdown Guide" Command="{x:Bind ViewModel.MarkdownGuideCommand}" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="About" Command="{x:Bind ViewModel.AboutCommand}" />
            </MenuBarItem>
        </MenuBar>

        <!-- Toolbar / Command Bar -->
        <CommandBar x:Name="MainCommandBar" Grid.Row="2" DefaultLabelPosition="Right" OverflowButtonVisibility="Auto" HorizontalAlignment="Stretch" Padding="0">
            <!-- Quick-access toolbar buttons -->
            <AppBarButton x:Name="BtnNew" Label="New" Command="{x:Bind ViewModel.NewFileCommand}" ToolTipService.ToolTip="New (Ctrl+N)">
                <AppBarButton.Icon>
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8A5;" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton x:Name="BtnOpen" Label="Open" Command="{x:Bind ViewModel.OpenFileCommand}" ToolTipService.ToolTip="Open (Ctrl+O)">
                <AppBarButton.Icon>
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8E5;" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton x:Name="BtnSave" Label="Save" Command="{x:Bind ViewModel.SaveFileCommand}" ToolTipService.ToolTip="Save (Ctrl+S)">
                <AppBarButton.Icon>
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE74E;" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarSeparator />

            <AppBarButton x:Name="BtnUndo" Label="Undo" Command="{x:Bind ViewModel.UndoCommand}" ToolTipService.ToolTip="Undo (Ctrl+Z)">
                <AppBarButton.Icon>
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE7A7;" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton x:Name="BtnRedo" Label="Redo" Command="{x:Bind ViewModel.RedoCommand}" ToolTipService.ToolTip="Redo (Ctrl+Y)">
                <AppBarButton.Icon>
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE7A6;" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarSeparator />

            <AppBarButton x:Name="BtnBold" Label="Bold" Command="{x:Bind ViewModel.BoldCommand}" ToolTipService.ToolTip="Bold (Ctrl+B)">
                <AppBarButton.Icon>
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8DD;" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton x:Name="BtnItalic" Label="Italic" Command="{x:Bind ViewModel.ItalicCommand}" ToolTipService.ToolTip="Italic (Ctrl+I)">
                <AppBarButton.Icon>
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8DB;" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton x:Name="BtnStrikethrough" Label="Strikethrough" Command="{x:Bind ViewModel.StrikethroughCommand}" ToolTipService.ToolTip="Strikethrough (Ctrl+Shift+X)">
                <AppBarButton.Icon>
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xEDE0;" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton x:Name="BtnInlineCode" Label="Inline Code" Command="{x:Bind ViewModel.InlineCodeCommand}" ToolTipService.ToolTip="Inline Code (Ctrl+`)">
                <AppBarButton.Icon>
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE943;" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarSeparator />

            <AppBarButton x:Name="BtnCodeBlock" Label="Code Block" Command="{x:Bind ViewModel.CodeBlockCommand}" ToolTipService.ToolTip="Code Block (Ctrl+Shift+C)">
                <AppBarButton.Icon>
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE943;" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton x:Name="BtnBlockquote" Label="Quote" Command="{x:Bind ViewModel.BlockquoteCommand}" ToolTipService.ToolTip="Blockquote (Ctrl+Q)">
                <AppBarButton.Icon>
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE908;" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarSeparator />

            <AppBarButton x:Name="BtnHeading1" Label="H1" Command="{x:Bind ViewModel.Heading1Command}" ToolTipService.ToolTip="Heading 1 (Ctrl+1)">
                <AppBarButton.Icon>
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8E2;" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton x:Name="BtnHeading2" Label="H2" Command="{x:Bind ViewModel.Heading2Command}" ToolTipService.ToolTip="Heading 2 (Ctrl+2)">
                <AppBarButton.Icon>
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8E2;" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton x:Name="BtnHeading3" Label="H3" Command="{x:Bind ViewModel.Heading3Command}" ToolTipService.ToolTip="Heading 3 (Ctrl+3)" />
            <AppBarSeparator />

            <AppBarButton x:Name="BtnUnorderedList" Label="List" Command="{x:Bind ViewModel.UnorderedListCommand}" ToolTipService.ToolTip="Unordered List (Ctrl+Shift+L)">
                <AppBarButton.Icon>
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8FD;" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton x:Name="BtnOrderedList" Label="Numbered" Command="{x:Bind ViewModel.OrderedListCommand}" ToolTipService.ToolTip="Ordered List (Ctrl+Shift+O)">
                <AppBarButton.Icon>
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8FD;" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton x:Name="BtnTaskList" Label="Tasks" Command="{x:Bind ViewModel.TaskListCommand}" ToolTipService.ToolTip="Task List (Ctrl+Shift+T)">
                <AppBarButton.Icon>
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE73E;" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarSeparator />

            <AppBarButton x:Name="BtnLink" Label="Link" Command="{x:Bind ViewModel.InsertLinkCommand}" ToolTipService.ToolTip="Insert Link (Ctrl+K)">
                <AppBarButton.Icon>
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE71B;" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton x:Name="BtnImage" Label="Image" Command="{x:Bind ViewModel.InsertImageCommand}" ToolTipService.ToolTip="Insert Image (Ctrl+Shift+I)">
                <AppBarButton.Icon>
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8B9;" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton x:Name="BtnTable" Label="Table" Command="{x:Bind ViewModel.InsertTableCommand}" ToolTipService.ToolTip="Insert Table (Ctrl+Shift+T)">
                <AppBarButton.Icon>
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8F1;" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarSeparator />

            <AppBarButton x:Name="BtnTogglePreview" Label="Preview" Command="{x:Bind ViewModel.TogglePreviewCommand}" ToolTipService.ToolTip="Toggle Preview (Ctrl+Shift+P)">
                <AppBarButton.Icon>
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8A1;" />
                </AppBarButton.Icon>
            </AppBarButton>
        </CommandBar>

        <!-- Main Content: Dual-pane Editor/Preview -->
        <Grid x:Name="MainContentGrid" Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="EditorColumn" Width="*" MinWidth="300" />
                <ColumnDefinition Width="Auto" />  <!-- Splitter -->
                <ColumnDefinition x:Name="PreviewColumn" Width="*" MinWidth="300" />
            </Grid.ColumnDefinitions>

            <!-- Left Pane: Markdown Editor -->
            <Grid x:Name="EditorPane" Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="8,4">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="EDITOR" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                        <TextBlock x:Name="EditorFileName" Text="Untitled.md" Style="{ThemeResource BodyTextBlockStyle}" VerticalAlignment="Center" Margin="8,0,0,0" />
                        <TextBlock x:Name="EditorDirtyIndicator" Text="●" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="Red" VerticalAlignment="Center" Margin="4,0,0,0" Visibility="Collapsed" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Margin="8" CornerRadius="4">
                    <RichEditBox x:Name="MarkdownEditor"
                                 FontFamily="Cascadia Code, Consolas, monospace"
                                 FontSize="14"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 ScrollViewer.HorizontalScrollMode="Auto"
                                 ScrollViewer.VerticalScrollMode="Auto"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 TextChanged="MarkdownEditor_TextChanged" />
                </Border>
            </Grid>

            <!-- Custom Splitter (WinUI 3 doesn't have GridSplitter) -->
            <Border x:Name="SplitterColumn" Grid.Column="1" Width="6" Background="Transparent">
                <Rectangle x:Name="SplitterHandle" Fill="Transparent" Width="6" HorizontalAlignment="Center" />
            </Border>

            <!-- Right Pane: Live Preview -->
            <Grid x:Name="PreviewPane" Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="8,4">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="PREVIEW" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                        <AppBarButton x:Name="BtnRefreshPreview" Label="Refresh" Command="{x:Bind ViewModel.RefreshPreviewCommand}" ToolTipService.ToolTip="Refresh Preview" Width="40" Height="40" Margin="8,0,0,0">
                            <AppBarButton.Icon>
                                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE72C;" />
                            </AppBarButton.Icon>
                        </AppBarButton>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Margin="8" CornerRadius="4">
                    <WebView2 x:Name="MarkdownPreview"
                              NavigationStarting="MarkdownPreview_NavigationStarting" />
                </Border>
            </Grid>
        </Grid>

        <!-- Status Bar -->
        <Grid x:Name="StatusBar" Grid.Row="4" Height="28" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="StatusCursorPosition" Grid.Column="0" Text="Ln 1, Col 1" Style="{ThemeResource CaptionTextBlockStyle}" VerticalAlignment="Center" Margin="12,0" />
            <TextBlock x:Name="StatusFileEncoding" Grid.Column="2" Text="UTF-8" Style="{ThemeResource CaptionTextBlockStyle}" VerticalAlignment="Center" Margin="0,0,12,0" />
            <TextBlock x:Name="StatusWordCount" Grid.Column="3" Text="Words: 0" Style="{ThemeResource CaptionTextBlockStyle}" VerticalAlignment="Center" Margin="0,0,12,0" />
            <TextBlock x:Name="StatusLineEnding" Grid.Column="4" Text="LF" Style="{ThemeResource CaptionTextBlockStyle}" VerticalAlignment="Center" Margin="0,0,12,0" />
            <ComboBox x:Name="StatusZoomCombo" Grid.Column="5" Width="80" Margin="0,0,12,0" VerticalAlignment="Center" SelectionChanged="StatusZoomCombo_SelectionChanged">
                <ComboBoxItem Content="50%" Tag="0.5" />
                <ComboBoxItem Content="75%" Tag="0.75" />
                <ComboBoxItem Content="100%" Tag="1.0" IsSelected="True" />
                <ComboBoxItem Content="125%" Tag="1.25" />
                <ComboBoxItem Content="150%" Tag="1.5" />
                <ComboBoxItem Content="200%" Tag="2.0" />
            </ComboBox>
        </Grid>
    </Grid>
</Window>