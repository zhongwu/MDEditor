<Window x:Class="MDEditor.GitHubCommitDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Commit to GitHub" Width="520" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource WindowForegroundBrush}">
    <StackPanel Margin="16">
        <TextBlock x:Name="TargetText" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,12" />

        <Border x:Name="ConflictBanner" Visibility="Collapsed" BorderBrush="IndianRed" BorderThickness="1" Padding="8" Margin="0,0,0,12">
            <TextBlock TextWrapping="Wrap"
                       Text="This file changed on GitHub since you opened it. Your edit will go to a new branch based on the version you opened, so nothing is overwritten. Open a pull request to merge it." />
        </Border>

        <TextBlock Text="Commit message" Margin="0,0,0,4" />
        <TextBox x:Name="CommitMessageBox" Margin="0,0,0,8" TextChanged="Input_Changed"
                 Background="{DynamicResource ControlBackgroundBrush}" Foreground="{DynamicResource ControlForegroundBrush}" />
        <TextBlock Text="Extended description (optional)" Margin="0,0,0,4" />
        <TextBox x:Name="DescriptionBox" Height="60" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,0,0,12"
                 Background="{DynamicResource ControlBackgroundBrush}" Foreground="{DynamicResource ControlForegroundBrush}" />

        <RadioButton x:Name="DirectRadio" GroupName="Target" Margin="0,0,0,6" Checked="Target_Changed" />
        <RadioButton x:Name="NewBranchRadio" GroupName="Target" Content="Create a new branch for this commit" Margin="0,0,0,6" Checked="Target_Changed" />
        <StackPanel x:Name="NewBranchPanel" Margin="22,0,0,0">
            <TextBox x:Name="BranchNameBox" Margin="0,0,0,6" TextChanged="Input_Changed" FontFamily="Cascadia Code, Consolas, monospace"
                     Background="{DynamicResource ControlBackgroundBrush}" Foreground="{DynamicResource ControlForegroundBrush}" />
            <CheckBox x:Name="PullRequestCheck" IsChecked="True" Checked="Target_Changed" Unchecked="Target_Changed" />
        </StackPanel>

        <TextBlock x:Name="StatusText" TextWrapping="Wrap" Margin="0,12,0,0" Visibility="Collapsed" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="CommitButton" Content="Commit" IsDefault="True" Padding="16,3" Margin="0,0,8,0" Click="Commit_Click" />
            <Button x:Name="CancelButton" Content="Cancel" IsCancel="True" Padding="16,3" />
        </StackPanel>
    </StackPanel>
</Window>
