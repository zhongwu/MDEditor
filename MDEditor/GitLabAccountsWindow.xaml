<Window x:Class="MDEditor.GitLabAccountsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:MDEditor.Localization"
        Title="{loc:Tr GL_AccountsTitle}" Height="560" Width="520" MinHeight="460" MinWidth="440"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource WindowForegroundBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16">
            <TextBlock Text="{loc:Tr GL_ConnectedAccounts}" FontWeight="SemiBold" Margin="0,0,0,8" />
            <Grid Height="120" Margin="0,0,0,8">
                <ListBox x:Name="AccountsList"
                         Background="{DynamicResource ControlBackgroundBrush}"
                         Foreground="{DynamicResource ControlForegroundBrush}"
                         SelectionChanged="AccountsList_SelectionChanged"
                         MouseDoubleClick="AccountsList_MouseDoubleClick" />
                <TextBlock x:Name="NoAccountsText" Text="{loc:Tr GL_NoAccounts}" Opacity="0.7"
                           HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
            </Grid>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                <Button x:Name="SetActiveButton" Content="{loc:Tr GH_SetActive}" Padding="12,3" Margin="0,0,8,0" Click="SetActive_Click" />
                <Button x:Name="RemoveButton" Content="{loc:Tr Common_Remove}" Padding="12,3" Click="Remove_Click" />
            </StackPanel>

            <TextBlock Text="{loc:Tr GL_ConnectHeading}" FontWeight="SemiBold" Margin="0,0,0,8" />

            <TextBlock Text="{loc:Tr GL_ServerLabel}" Margin="0,0,0,4" />
            <TextBox x:Name="ServerBox" Margin="0,0,0,2" VerticalContentAlignment="Center" KeyDown="Input_KeyDown"
                     Background="{DynamicResource ControlBackgroundBrush}" Foreground="{DynamicResource ControlForegroundBrush}" />
            <TextBlock Text="{loc:Tr GL_ServerHint}" Opacity="0.7" TextWrapping="Wrap" Margin="0,0,0,10" />

            <TextBlock Text="{loc:Tr GL_TokenLabel}" Margin="0,0,0,4" />
            <PasswordBox x:Name="TokenBox" Margin="0,0,0,2" VerticalContentAlignment="Center" KeyDown="Input_KeyDown"
                         Background="{DynamicResource ControlBackgroundBrush}" Foreground="{DynamicResource ControlForegroundBrush}" />
            <TextBlock TextWrapping="Wrap" Opacity="0.8" Margin="0,0,0,10">
                <Run Text="{loc:Tr GL_TokenNote}" />
                <Hyperlink Click="CreateTokenLink_Click"><Run Text="{loc:Tr GL_CreateToken}" /></Hyperlink>
            </TextBlock>

            <CheckBox x:Name="SkipCertCheck" Content="{loc:Tr GL_SkipCert}" Margin="0,0,0,12" />

            <Button x:Name="ConnectButton" Content="{loc:Tr GL_Connect}" Padding="16,3" HorizontalAlignment="Left" Click="Connect_Click" />

            <TextBlock x:Name="StatusText" TextWrapping="Wrap" Margin="0,12,0,0" Visibility="Collapsed" />
        </StackPanel>
    </ScrollViewer>
</Window>
