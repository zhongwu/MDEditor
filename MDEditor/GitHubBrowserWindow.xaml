<Window x:Class="MDEditor.GitHubBrowserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:MDEditor.Localization"
        Title="{loc:Tr GH_OpenFromGitHubTitle}" Height="560" Width="820" MinHeight="400" MinWidth="600"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource WindowForegroundBrush}">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" MinWidth="200" />
            <ColumnDefinition Width="6" />
            <ColumnDefinition Width="3*" MinWidth="240" />
        </Grid.ColumnDefinitions>

        <!-- Repositories -->
        <DockPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,6" LastChildFill="True">
            <Button x:Name="RefreshButton" DockPanel.Dock="Right" ToolTip="{loc:Tr GH_ReloadRepos}" Padding="6,2" Margin="6,0,0,0" Click="Refresh_Click">
                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE72C;" />
            </Button>
            <TextBox x:Name="RepoFilterBox" VerticalContentAlignment="Center" TextChanged="RepoFilterBox_TextChanged"
                     ToolTip="{loc:Tr GH_FilterRepos}"
                     Background="{DynamicResource ControlBackgroundBrush}" Foreground="{DynamicResource ControlForegroundBrush}" />
        </DockPanel>
        <ListBox x:Name="RepoList" Grid.Row="1" Grid.Column="0"
                 Background="{DynamicResource ControlBackgroundBrush}" Foreground="{DynamicResource ControlForegroundBrush}"
                 SelectionChanged="RepoList_SelectionChanged" />

        <GridSplitter Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent" />

        <!-- Files -->
        <DockPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,6">
            <TextBlock Text="{loc:Tr GH_Branch}" VerticalAlignment="Center" Margin="0,0,6,0" />
            <ComboBox x:Name="BranchCombo" Width="180" SelectionChanged="BranchCombo_SelectionChanged" />
            <CheckBox x:Name="MarkdownOnlyCheck" Content="{loc:Tr GH_MarkdownOnly}" IsChecked="True" VerticalAlignment="Center"
                      Margin="12,0,0,0" Checked="MarkdownOnlyCheck_Changed" Unchecked="MarkdownOnlyCheck_Changed" />
        </DockPanel>
        <Grid Grid.Row="1" Grid.Column="2">
            <TreeView x:Name="FileTree"
                      Background="{DynamicResource ControlBackgroundBrush}" Foreground="{DynamicResource ControlForegroundBrush}"
                      SelectedItemChanged="FileTree_SelectedItemChanged" MouseDoubleClick="FileTree_MouseDoubleClick"
                      KeyDown="FileTree_KeyDown" />
            <TextBlock x:Name="TreePlaceholder" Text="{loc:Tr GH_SelectRepo}" Opacity="0.7" TextWrapping="Wrap" TextAlignment="Center"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16" IsHitTestVisible="False" />
        </Grid>

        <!-- Footer -->
        <DockPanel Grid.Row="2" Grid.ColumnSpan="3" Margin="0,10,0,0">
            <Button DockPanel.Dock="Right" Content="{loc:Tr Common_Cancel}" IsCancel="True" Padding="16,3" Margin="8,0,0,0" />
            <Button x:Name="OpenButton" DockPanel.Dock="Right" Content="{loc:Tr Common_Open}" IsDefault="True" IsEnabled="False" Padding="16,3" Click="Open_Click" />
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Opacity="0.8" />
        </DockPanel>
    </Grid>
</Window>
