<Window x:Class="MDEditor.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:MDEditor.Localization"
        Title="{loc:Tr Menu_Settings}" Height="520" Width="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource WindowForegroundBrush}">
    <TabControl Margin="8">
        <TabItem Header="{loc:Tr Settings_Appearance}">
            <StackPanel Margin="16">
                <TextBlock Text="{loc:Tr Settings_Theme}" FontWeight="SemiBold" Margin="0,0,0,8" />
                <RadioButton x:Name="ThemeLightRadio" Content="{loc:Tr Settings_Light}" GroupName="Theme" Margin="0,0,0,4" Checked="ThemeRadio_Checked" />
                <RadioButton x:Name="ThemeDarkRadio" Content="{loc:Tr Settings_Dark}" GroupName="Theme" Margin="0,0,0,4" Checked="ThemeRadio_Checked" />
                <RadioButton x:Name="ThemeSystemRadio" Content="{loc:Tr Settings_MatchWindows}" GroupName="Theme" Checked="ThemeRadio_Checked" />

                <TextBlock Text="{loc:Tr Settings_Language}" FontWeight="SemiBold" Margin="0,20,0,4" />
                <ComboBox x:Name="LanguageCombo" Width="200" HorizontalAlignment="Left" SelectionChanged="LanguageCombo_SelectionChanged" />
            </StackPanel>
        </TabItem>

        <TabItem Header="{loc:Tr Settings_Editor}">
            <StackPanel Margin="16">
                <TextBlock Text="{loc:Tr Settings_FontFamily}" FontWeight="SemiBold" Margin="0,0,0,4" />
                <ComboBox x:Name="FontFamilyCombo" Width="280" HorizontalAlignment="Left" Margin="0,0,0,16" SelectionChanged="FontFamilyCombo_SelectionChanged">
                    <ComboBoxItem Content="Cascadia Code" Tag="Cascadia Code, Consolas, monospace" />
                    <ComboBoxItem Content="Consolas" Tag="Consolas, monospace" />
                    <ComboBoxItem Content="Courier New" Tag="Courier New, monospace" />
                    <ComboBoxItem Content="Segoe UI" Tag="Segoe UI" />
                </ComboBox>

                <TextBlock Text="{loc:Tr Settings_FontSize}" FontWeight="SemiBold" Margin="0,0,0,4" />
                <ComboBox x:Name="FontSizeCombo" Width="100" HorizontalAlignment="Left" Margin="0,0,0,16" SelectionChanged="FontSizeCombo_SelectionChanged">
                    <ComboBoxItem Content="10" Tag="10" />
                    <ComboBoxItem Content="11" Tag="11" />
                    <ComboBoxItem Content="12" Tag="12" />
                    <ComboBoxItem Content="13" Tag="13" />
                    <ComboBoxItem Content="14" Tag="14" />
                    <ComboBoxItem Content="16" Tag="16" />
                    <ComboBoxItem Content="18" Tag="18" />
                    <ComboBoxItem Content="20" Tag="20" />
                    <ComboBoxItem Content="24" Tag="24" />
                </ComboBox>

                <TextBlock Text="{loc:Tr Settings_AutoSave}" FontWeight="SemiBold" Margin="0,0,0,4" />
                <ComboBox x:Name="AutoSaveCombo" Width="160" HorizontalAlignment="Left" Margin="0,0,0,16" SelectionChanged="AutoSaveCombo_SelectionChanged">
                    <ComboBoxItem Content="{loc:Tr Settings_10Seconds}" Tag="10" />
                    <ComboBoxItem Content="{loc:Tr Settings_15Seconds}" Tag="15" />
                    <ComboBoxItem Content="{loc:Tr Settings_30Seconds}" Tag="30" />
                    <ComboBoxItem Content="{loc:Tr Settings_1Minute}" Tag="60" />
                    <ComboBoxItem Content="{loc:Tr Settings_2Minutes}" Tag="120" />
                </ComboBox>

                <TextBlock Text="{loc:Tr Settings_LineEnding}" FontWeight="SemiBold" Margin="0,0,0,4" />
                <ComboBox x:Name="LineEndingCombo" Width="160" HorizontalAlignment="Left" SelectionChanged="LineEndingCombo_SelectionChanged">
                    <ComboBoxItem Content="LF (Unix)" Tag="LF" />
                    <ComboBoxItem Content="CRLF (Windows)" Tag="CRLF" />
                </ComboBox>
            </StackPanel>
        </TabItem>

        <TabItem Header="{loc:Tr Settings_MarkdownPreview}">
            <StackPanel Margin="16">
                <TextBlock Text="{loc:Tr Settings_Flavor}" FontWeight="SemiBold" Margin="0,0,0,8" />
                <CheckBox x:Name="MathCheck" Content="{loc:Tr Settings_Math}" Margin="0,0,0,4" Checked="FlavorCheck_Changed" Unchecked="FlavorCheck_Changed" />
                <CheckBox x:Name="DiagramsCheck" Content="{loc:Tr Settings_Diagrams}" Margin="0,0,0,4" Checked="FlavorCheck_Changed" Unchecked="FlavorCheck_Changed" />
                <CheckBox x:Name="EmojiCheck" Content="{loc:Tr Settings_Emoji}" Margin="0,0,0,4" Checked="FlavorCheck_Changed" Unchecked="FlavorCheck_Changed" />
                <CheckBox x:Name="FootnotesCheck" Content="{loc:Tr Settings_Footnotes}" Margin="0,0,0,4" Checked="FlavorCheck_Changed" Unchecked="FlavorCheck_Changed" />
                <CheckBox x:Name="TaskListsCheck" Content="{loc:Tr Settings_TaskLists}" Margin="0,0,0,16" Checked="FlavorCheck_Changed" Unchecked="FlavorCheck_Changed" />

                <TextBlock Text="{loc:Tr Settings_CustomCss}" FontWeight="SemiBold" Margin="0,0,0,4" />
                <TextBox x:Name="CustomCssBox"
                         Height="140"
                         AcceptsReturn="True"
                         AcceptsTab="True"
                         TextWrapping="Wrap"
                         FontFamily="Cascadia Code, Consolas, monospace"
                         FontSize="12"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         LostFocus="CustomCssBox_LostFocus" />
                <TextBlock Text="{loc:Tr Settings_CustomCssNote}" Foreground="Gray" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </TabItem>

        <TabItem x:Name="ShortcutsTab" Header="{loc:Tr Menu_KeyboardShortcuts}">
            <DockPanel Margin="16">
                <TextBlock DockPanel.Dock="Top" Text="{loc:Tr Settings_ShortcutsNote}"
                           Foreground="Gray" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12" />
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="ShortcutsPanel" />
                </ScrollViewer>
            </DockPanel>
        </TabItem>
    </TabControl>
</Window>
