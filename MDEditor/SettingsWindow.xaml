<Window x:Class="MDEditor.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Height="520" Width="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource WindowForegroundBrush}">
    <TabControl Margin="8">
        <TabItem Header="Appearance">
            <StackPanel Margin="16">
                <TextBlock Text="Theme" FontWeight="SemiBold" Margin="0,0,0,8" />
                <RadioButton x:Name="ThemeLightRadio" Content="Light" GroupName="Theme" Margin="0,0,0,4" Checked="ThemeRadio_Checked" />
                <RadioButton x:Name="ThemeDarkRadio" Content="Dark" GroupName="Theme" Margin="0,0,0,4" Checked="ThemeRadio_Checked" />
                <RadioButton x:Name="ThemeSystemRadio" Content="Match Windows" GroupName="Theme" Checked="ThemeRadio_Checked" />
            </StackPanel>
        </TabItem>

        <TabItem Header="Editor">
            <StackPanel Margin="16">
                <TextBlock Text="Font Family" FontWeight="SemiBold" Margin="0,0,0,4" />
                <ComboBox x:Name="FontFamilyCombo" Width="280" HorizontalAlignment="Left" Margin="0,0,0,16" SelectionChanged="FontFamilyCombo_SelectionChanged">
                    <ComboBoxItem Content="Cascadia Code" Tag="Cascadia Code, Consolas, monospace" />
                    <ComboBoxItem Content="Consolas" Tag="Consolas, monospace" />
                    <ComboBoxItem Content="Courier New" Tag="Courier New, monospace" />
                    <ComboBoxItem Content="Segoe UI" Tag="Segoe UI" />
                </ComboBox>

                <TextBlock Text="Font Size" FontWeight="SemiBold" Margin="0,0,0,4" />
                <ComboBox x:Name="FontSizeCombo" Width="100" HorizontalAlignment="Left" Margin="0,0,0,16" SelectionChanged="FontSizeCombo_SelectionChanged">
                    <ComboBoxItem Content="10" Tag="10" />
                    <ComboBoxItem Content="11" Tag="11" />
                    <ComboBoxItem Content="12" Tag="12" />
                    <ComboBoxItem Content="13" Tag="13" />
                    <ComboBoxItem Content="14" Tag="14" />
                    <ComboBoxItem Content="16" Tag="16" />
                    <ComboBoxItem Content="18" Tag="18" />
                    <ComboBoxItem Content="20" Tag="20" />
                    <ComboBoxItem Content="24" Tag="24" />
                </ComboBox>

                <TextBlock Text="Auto-save Interval" FontWeight="SemiBold" Margin="0,0,0,4" />
                <ComboBox x:Name="AutoSaveCombo" Width="160" HorizontalAlignment="Left" Margin="0,0,0,16" SelectionChanged="AutoSaveCombo_SelectionChanged">
                    <ComboBoxItem Content="10 seconds" Tag="10" />
                    <ComboBoxItem Content="15 seconds" Tag="15" />
                    <ComboBoxItem Content="30 seconds" Tag="30" />
                    <ComboBoxItem Content="1 minute" Tag="60" />
                    <ComboBoxItem Content="2 minutes" Tag="120" />
                </ComboBox>

                <TextBlock Text="Line Ending (on Save)" FontWeight="SemiBold" Margin="0,0,0,4" />
                <ComboBox x:Name="LineEndingCombo" Width="160" HorizontalAlignment="Left" SelectionChanged="LineEndingCombo_SelectionChanged">
                    <ComboBoxItem Content="LF (Unix)" Tag="LF" />
                    <ComboBoxItem Content="CRLF (Windows)" Tag="CRLF" />
                </ComboBox>
            </StackPanel>
        </TabItem>

        <TabItem Header="Markdown &amp; Preview">
            <StackPanel Margin="16">
                <TextBlock Text="Markdown Flavor" FontWeight="SemiBold" Margin="0,0,0,8" />
                <CheckBox x:Name="MathCheck" Content="Math (KaTeX)" Margin="0,0,0,4" Checked="FlavorCheck_Changed" Unchecked="FlavorCheck_Changed" />
                <CheckBox x:Name="DiagramsCheck" Content="Diagrams (Mermaid)" Margin="0,0,0,4" Checked="FlavorCheck_Changed" Unchecked="FlavorCheck_Changed" />
                <CheckBox x:Name="EmojiCheck" Content="Emoji shortcodes" Margin="0,0,0,4" Checked="FlavorCheck_Changed" Unchecked="FlavorCheck_Changed" />
                <CheckBox x:Name="FootnotesCheck" Content="Footnotes" Margin="0,0,0,4" Checked="FlavorCheck_Changed" Unchecked="FlavorCheck_Changed" />
                <CheckBox x:Name="TaskListsCheck" Content="Task Lists" Margin="0,0,0,16" Checked="FlavorCheck_Changed" Unchecked="FlavorCheck_Changed" />

                <TextBlock Text="Custom Preview CSS" FontWeight="SemiBold" Margin="0,0,0,4" />
                <TextBox x:Name="CustomCssBox"
                         Height="140"
                         AcceptsReturn="True"
                         AcceptsTab="True"
                         TextWrapping="Wrap"
                         FontFamily="Cascadia Code, Consolas, monospace"
                         FontSize="12"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         LostFocus="CustomCssBox_LostFocus" />
                <TextBlock Text="Applies only to the live preview - exported/copied HTML is unaffected." Foreground="Gray" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </TabItem>

        <TabItem x:Name="ShortcutsTab" Header="Keyboard Shortcuts">
            <DockPanel Margin="16">
                <TextBlock DockPanel.Dock="Top" Text="Click a shortcut box and press a new key combination to rebind it."
                           Foreground="Gray" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12" />
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="ShortcutsPanel" />
                </ScrollViewer>
            </DockPanel>
        </TabItem>
    </TabControl>
</Window>
