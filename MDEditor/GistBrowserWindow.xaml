<Window x:Class="MDEditor.GistBrowserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:MDEditor.Localization"
        Title="{loc:Tr Gist_OpenTitle}" Height="520" Width="760" MinHeight="380" MinWidth="560"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource WindowForegroundBrush}">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" MinWidth="240" />
            <ColumnDefinition Width="6" />
            <ColumnDefinition Width="2*" MinWidth="180" />
        </Grid.ColumnDefinitions>

        <!-- Open any gist by link -->
        <DockPanel Grid.Row="0" Grid.ColumnSpan="3" Margin="0,0,0,10">
            <TextBlock Text="{loc:Tr Gist_UrlLabel}" VerticalAlignment="Center" Margin="0,0,6,0" />
            <Button x:Name="GoButton" DockPanel.Dock="Right" Content="{loc:Tr Gist_Go}" Padding="12,2" Margin="6,0,0,0" Click="Go_Click" />
            <TextBox x:Name="UrlBox" VerticalContentAlignment="Center" PreviewKeyDown="UrlBox_PreviewKeyDown" AutomationProperties.Name="{loc:Tr Gist_UrlTip}" ToolTip="{loc:Tr Gist_UrlTip}"
                     Background="{DynamicResource ControlBackgroundBrush}" Foreground="{DynamicResource ControlForegroundBrush}" />
        </DockPanel>

        <!-- My gists -->
        <DockPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,6">
            <Button x:Name="RefreshButton" DockPanel.Dock="Right" AutomationProperties.Name="{loc:Tr Gist_Reload}" ToolTip="{loc:Tr Gist_Reload}" Padding="6,2" Margin="6,0,0,0" Click="Refresh_Click">
                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE72C;" />
            </Button>
            <TextBox x:Name="FilterBox" VerticalContentAlignment="Center" TextChanged="FilterBox_TextChanged" AutomationProperties.Name="{loc:Tr Gist_Filter}" ToolTip="{loc:Tr Gist_Filter}"
                     Background="{DynamicResource ControlBackgroundBrush}" Foreground="{DynamicResource ControlForegroundBrush}" />
        </DockPanel>
        <Grid Grid.Row="2" Grid.Column="0">
            <ListBox x:Name="GistList" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     Background="{DynamicResource ControlBackgroundBrush}" Foreground="{DynamicResource ControlForegroundBrush}"
                     SelectionChanged="GistList_SelectionChanged" />
            <TextBlock x:Name="GistPlaceholder" Opacity="0.7" TextWrapping="Wrap" TextAlignment="Center" Margin="16"
                       HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed" />
        </Grid>

        <GridSplitter Grid.Row="1" Grid.RowSpan="2" Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent" />

        <!-- Files of the selected gist -->
        <TextBlock Grid.Row="1" Grid.Column="2" Text="{loc:Tr Gist_Files}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,0,6" />
        <ListBox x:Name="FileList" Grid.Row="2" Grid.Column="2"
                 Background="{DynamicResource ControlBackgroundBrush}" Foreground="{DynamicResource ControlForegroundBrush}"
                 SelectionChanged="FileList_SelectionChanged" MouseDoubleClick="FileList_MouseDoubleClick" />

        <DockPanel Grid.Row="3" Grid.ColumnSpan="3" Margin="0,10,0,0">
            <Button DockPanel.Dock="Right" Content="{loc:Tr Common_Cancel}" IsCancel="True" Padding="16,3" Margin="8,0,0,0" />
            <Button x:Name="OpenButton" DockPanel.Dock="Right" Content="{loc:Tr Common_Open}" IsDefault="True" IsEnabled="False" Padding="16,3" Click="Open_Click" />
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Opacity="0.8" />
        </DockPanel>
    </Grid>
</Window>
