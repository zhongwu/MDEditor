<Window x:Class="MDEditor.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:MDEditor.Localization"
        Title="{loc:Tr Menu_About}" Width="380" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource WindowForegroundBrush}">
    <StackPanel Margin="24">
        <TextBlock Text="MDEditor" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" />
        <TextBlock x:Name="VersionText" HorizontalAlignment="Center" Foreground="Gray" Margin="0,4,0,16" />
        <TextBlock Text="{loc:Tr About_Tagline}"
                   TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,16" />
        <TextBlock Text="WPF (.NET 10) · Markdig · WebView2 · CommunityToolkit.Mvvm"
                   TextWrapping="Wrap" TextAlignment="Center" Foreground="Gray" FontSize="11" Margin="0,0,0,16" />
        <TextBlock HorizontalAlignment="Center" Margin="0,0,0,20">
            <Hyperlink NavigateUri="https://github.com/zhongwu/MDEditor" RequestNavigate="Hyperlink_RequestNavigate">
                github.com/zhongwu/MDEditor
            </Hyperlink>
        </TextBlock>
        <Button Content="{loc:Tr Common_Close}" HorizontalAlignment="Center" Padding="24,4" Click="CloseButton_Click" IsDefault="True" IsCancel="True" />
    </StackPanel>
</Window>
